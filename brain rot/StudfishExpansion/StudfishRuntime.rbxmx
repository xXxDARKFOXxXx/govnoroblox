local active = {}
local pending = {}
local maxDistance = 150
local tau = math.pi * 2
local sin, cos, rad = math.sin, math.cos, math.rad
local childNames = {
	"FishTail", "FishTailTip", "FishFinL", "FishFinR", "FishCrest", "FishLure", "FishFX",
}

local function makeEmitter(anchor, style, scale)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = style.name
	emitter.Enabled = false
	emitter.Texture = style.texture
	emitter.Rate = style.rate
	emitter.Lifetime = NumberRange.new(style.life[1], style.life[2])
	emitter.Speed = NumberRange.new(style.speed[1] * scale, style.speed[2] * scale)
	emitter.SpreadAngle = Vector2.new(style.spread, style.spread)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.LightInfluence = 0
	emitter.LightEmission = style.emission or 0.55
	emitter.Drag = 0.7
	emitter.Acceleration = Vector3.new(0, (style.accel or 0.65) * scale, 0)
	emitter.Rotation = NumberRange.new(-180, 180)
	emitter.RotSpeed = NumberRange.new(-80, 80)
	emitter.Color = ColorSequence.new(style.first, style.last)
	local size = style.size * scale
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, size * 0.48),
		NumberSequenceKeypoint.new(0.23, size),
		NumberSequenceKeypoint.new(1, size * 0.68),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.13, 0.12),
		NumberSequenceKeypoint.new(0.62, 0.24),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Parent = anchor
	return emitter
end

local function register(root)
	local config = species[root.Name]
	local mesh = root:FindFirstAncestorWhichIsA("MeshPart")
	if not config or not mesh or active[root] or not root:IsDescendantOf(Workspace) then
		return
	end

	local bones = {}
	for _, name in config.joints or childNames do
		local bone = root:FindFirstChild(name, true)
		if bone and bone:IsA("Bone") then
			bones[name] = bone
		elseif config.joints or name ~= "FishLure" or config.lure then
			return
		end
	end

	local measureBone = bones[config.measureName or "FishTail"]
	local measureDistance = config.measureDistance or config.tailDistance
	local scale = (measureBone.WorldPosition - root.WorldPosition).Magnitude / measureDistance
	scale = math.clamp(scale, 0.08, 16)
	local particleScale = math.clamp(scale, 0.25, 5)
	local up = root.WorldCFrame:VectorToObjectSpace(Vector3.yAxis)
	local anchor = Instance.new("Attachment")
	anchor.Name = "StudFishEffects"
	anchor.Parent = mesh
	anchor.WorldCFrame = CFrame.new(bones.FishFX.WorldPosition)
	local emitters = {}
	for index, style in config.fx do
		emitters[index] = makeEmitter(anchor, style, particleScale)
	end

	local light
	if config.light then
		light = Instance.new("PointLight")
		light.Name = "LureLight"
		light.Enabled = false
		light.Color = config.light
		light.Range = math.clamp((config.lightRange or 4.2) * scale, 2, 18)
		light.Parent = anchor
	end

	local p = root.WorldPosition
	active[root] = {
		mesh = mesh,
		config = config,
		bones = bones,
		scale = scale,
		up = up,
		phase = (p.X * 0.17 + p.Z * 0.13) % 1,
		anchor = anchor,
		emitters = emitters,
		light = light,
		visible = false,
	}
end

local function consider(instance)
	if not instance:IsA("Bone") then
		return
	end
	local candidate = instance
	while candidate and candidate:IsA("Bone") do
		if species[candidate.Name] then
			local root = candidate
			if not active[root] and not pending[root] then
				pending[root] = true
				task.defer(function()
					pending[root] = nil
					register(root)
				end)
			end
			return
		end
		candidate = candidate.Parent
	end
end

Workspace.DescendantAdded:Connect(consider)
for _, instance in Workspace:GetDescendants() do
	consider(instance)
end

local function setVisible(rig, visible)
	rig.visible = visible
	for _, emitter in rig.emitters do
		emitter.Enabled = visible
		if not visible then
			emitter:Clear()
		end
	end
	if rig.light then
		rig.light.Enabled = visible
	end
end

local function sumMotion(terms, time)
	local x, y, z = 0, 0, 0
	for _, wave in terms do
		local amplitude = sin(wave[4] * time + wave[5])
		x += wave[1] * amplitude
		y += wave[2] * amplitude
		z += wave[3] * amplitude
	end
	return x, y, z
end

local function animateTracks(root, rig, t, bob)
	local config = rig.config
	for name, track in config.tracks do
		local bone = rig.bones[name] or root
		local x, y, z = sumMotion(track, t)
		local rotation = CFrame.Angles(rad(x), rad(y), rad(z))
		local move = config.moves[name]
		if bone == root then
			bone.Transform = CFrame.new(rig.up * bob) * rotation
		elseif move then
			local dx, dy, dz = sumMotion(move, t)
			bone.Transform = CFrame.new(Vector3.new(dx, dy, dz) * rig.scale) * rotation
		else
			bone.Transform = rotation
		end
	end
end

local function animateClassic(root, rig, t, y)
	local config, bones = rig.config, rig.bones
	local fast = 2 * t
	root.Transform = CFrame.new(rig.up * y)
		* CFrame.Angles(rad(config.roll * sin(t + 0.4)), 0, rad(config.pitch * sin(t - 0.25)))
	bones.FishTail.Transform = CFrame.Angles(0, rad(config.tail * sin(fast + 0.23)), 0)
	bones.FishTailTip.Transform = CFrame.Angles(0, rad(config.tip * sin(fast - 0.66)), 0)
	bones.FishFinL.Transform = CFrame.Angles(rad(config.fin * sin(fast + 0.3)), 0, 0)
	bones.FishFinR.Transform = CFrame.Angles(rad(-config.fin * sin(fast + 0.9)), 0, 0)
	bones.FishCrest.Transform = CFrame.Angles(rad(config.crest * sin(fast - 0.55)), 0, 0)
	if config.lure then
		bones.FishLure.Transform = CFrame.Angles(
			rad(config.lure * sin(t + 0.1)), 0, rad(config.lure * 0.65 * sin(fast - 0.35))
		)
		bones.FishFX.Transform = CFrame.Angles(rad(config.bulb * sin(fast - 0.65)), 0, 0)
	end
end

local function animate(root, rig, time)
	local config, bones = rig.config, rig.bones
	local cycle = time / config.period + rig.phase
	local whole = math.floor(cycle)
	local t = (cycle - whole) * tau
	local fast = 2 * t
	local y = config.bob * rig.scale * (0.5 - 0.5 * cos(t))
	if config.tracks then
		animateTracks(root, rig, t, y)
	else
		animateClassic(root, rig, t, y)
	end
	if rig.light then
		rig.light.Brightness = (config.lightBase or 1.4) + (config.lightPulse or 0.65) * sin(fast - 0.65)
	end

	rig.anchor.WorldCFrame = CFrame.new(bones.FishFX.TransformedWorldCFrame.Position)
	if rig.lastCycle and whole ~= rig.lastCycle then
		for index, style in config.fx do
			if style.burst then
				rig.emitters[index]:Emit(style.burst)
			end
		end
	end
	rig.lastCycle = whole
end

RunService.PreRender:Connect(function()
	local camera = Workspace.CurrentCamera
	local time = Workspace:GetServerTimeNow()
	for root, rig in active do
		if not root:IsDescendantOf(Workspace) or not root:IsDescendantOf(rig.mesh) then
			rig.anchor:Destroy()
			active[root] = nil
			consider(root)
			continue
		end
		local visible = camera ~= nil
			and (camera.CFrame.Position - root.WorldPosition).Magnitude <= maxDistance * math.max(1, rig.scale)
		if visible ~= rig.visible then
			setVisible(rig, visible)
			rig.lastCycle = nil
		end
		if visible then
			animate(root, rig, time)
		end
	end
end)
]]></ProtectedString>
    </Properties>
  </Item>
</roblox>
