0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4286491312</Color3uint8><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">false</bool><bool name="CastShadow">false</bool><token name="Material">272</token><token name="shape">1</token><float name="Transparency">0.94</float><float name="Reflectance">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="LeftSurface">0</token><token name="RightSurface">0</token><token name="FrontSurface">0</token><token name="BackSurface">0</token></Properties></Item></Item></Item></Item><Item class="Lighting" referent="OM21600"><Properties><string name="Name">Lighting</string><Color3 name="Ambient"><R>0.5372549019607843</R><G>0.6392156862745098</G><B>0.7058823529411765</B></Color3><Color3 name="OutdoorAmbient"><R>0.6470588235294118</R><G>0.7372549019607844</G><B>0.7843137254901961</B></Color3><float name="Brightness">2</float><float name="ClockTime">14</float><float name="GeographicLatitude">23</float><bool name="GlobalShadows">true</bool><float name="EnvironmentDiffuseScale">0.7</float><float name="EnvironmentSpecularScale">0.45</float><Color3 name="FogColor"><R>0.6039215686274509</R><G>0.8549019607843137</G><B>0.8980392156862745</B></Color3><float name="FogStart">700</float><float name="FogEnd">2600</float></Properties><Item class="Atmosphere" referent="OM21598"><Properties><string name="Name">OceanAir</string><float name="Density">0.16</float><float name="Offset">0.12</float><Color3 name="Color"><R>0.7333333333333333</R><G>0.9137254901960784</G><B>0.9568627450980393</B></Color3><Color3 name="Decay"><R>0.48627450980392156</R><G>0.7294117647058823</G><B>0.8352941176470589</B></Color3><float name="Glare">0.08</float><float name="Haze">0.6</float></Properties></Item><Item class="BloomEffect" referent="OM21599"><Properties><string name="Name">SoftWaterGlow</string><float name="Intensity">0.12</float><float name="Size">20</float><float name="Threshold">1.5</float></Properties></Item></Item><Item class="ServerStorage" referent="OM21602"><Properties><string name="Name">ServerStorage</string></Properties><Item class="ModuleScript" referent="OM21601"><Properties><string name="Name">OceanWater</string><ProtectedString name="Source"><![CDATA[-- Real, swimmable Terrain water. Also callable from Studio's Command Bar.
-- Only writes inside this map's canal; never clears the user's Terrain.
local Water = {}
local Environment = require(game:GetService("ReplicatedStorage"):WaitForChild("OceanEnvironment"))
Water.SurfaceY = Environment.SurfaceY
Water.Width = Environment.HalfWidth * 2
Water.SectionLength = Environment.SectionLength
Water.FloorLevels = Environment.FloorLevels
Water.FloorAt = Environment.FloorAt

function Water.ApplyAppearance()
	local terrain = workspace.Terrain
	-- Maximum clarity is deliberate: the final section is 164 studs deep.
	-- Saturated cyan and reflected sky otherwise flatten the visible depth.
	terrain.WaterColor = Color3.fromRGB(126, 170, 176)
	terrain.WaterTransparency = 1
	terrain.WaterReflectance = 0
	terrain.WaterWaveSize = 0.06
	terrain.WaterWaveSpeed = 4
	local map = workspace:FindFirstChild("OceanMap")
	if map then
		local preview = map:FindFirstChild("WaterPreview")
		if preview then preview:Destroy() end
	end
end

function Water.Build()
	Water.ApplyAppearance()
	local terrain = workspace.Terrain
	-- All bounds align with the 4-stud terrain grid. Water extends below
	-- the solid sloping floor, so every exposed point stays swimmable.
	for z = 0, 956, 4 do
		local floor = math.min(Water.FloorAt(z), Water.FloorAt(z + 4))
		local bottom = math.floor((floor - 8) / 4) * 4
		terrain:FillBlock(CFrame.new(0, bottom / 2, z + 2), Vector3.new(128, -bottom, 4), Enum.Material.Water)
	end
	local map = workspace:FindFirstChild("OceanMap")
	if map then
		map:SetAttribute("WaterBaked", true)
	end
end

return Water
]]></ProtectedString></Properties></Item></Item><Item class="ReplicatedStorage" referent="OM21604"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="OM21603"><Properties><string name="Name">OceanEnvironment</string><ProtectedString name="Source"><![CDATA[-- Shared geometry rules for water, swimming, camera effects and breath.
local Environment = {}
Environment.SurfaceY = 0
Environment.HalfWidth = 64
Environment.SectionLength = 192
Environment.Length = 960
Environment.FloorLevels = {4, -20, -44, -76, -116, -164}
Environment.VerticalSpeed = 10

function Environment.FloorAt(z)
	local section = math.clamp(math.floor(z / Environment.SectionLength) + 1, 1, 5)
	local alpha = math.clamp((z - (section - 1) * Environment.SectionLength) / Environment.SectionLength, 0, 1)
	return Environment.FloorLevels[section] + (Environment.FloorLevels[section + 1] - Environment.FloorLevels[section]) * alpha
end

function Environment.IsSubmerged(position, margin)
	return math.abs(position.X) < Environment.HalfWidth
		and position.Z >= 0 and position.Z < Environment.Length
		and position.Y < Environment.SurfaceY - (margin or 0.12)
		and position.Y > Environment.FloorAt(position.Z) - 0.5
end

function Environment.VerticalTarget(up, down)
	return ((up and 1 or 0) - (down and 1 or 0)) * Environment.VerticalSpeed
end

return Environment
]]></ProtectedString></Properties></Item></Item><Item class="ServerScriptService" referent="OM21606"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="OM21605"><Properties><string name="Name">OceanStart</string><ProtectedString name="Source"><![CDATA[local map = workspace:WaitForChild("OceanMap")
local water = require(game:GetService("ServerStorage"):WaitForChild("OceanWater"))
-- Apply clarity even when Terrain has already been baked in Studio.
water.ApplyAppearance()
if not map:GetAttribute("WaterBaked") then
	water.Build()
end
]]></ProtectedString><bool name="Disabled">false</bool></Properties></Item></Item><Item class="StarterPlayer" referent="OM21610"><Properties><string name="Name">StarterPlayer</string><float name="CameraMaxZoomDistance">80</float><float name="CameraMinZoomDistance">0.5</float></Properties><Item class="StarterPlayerScripts" referent="OM21609"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="OM21607"><Properties><string name="Name">OceanAmbience</string><ProtectedString name="Source"><![CDATA[-- Ambient details only: swaying wall kelp, ascending bubbles, wall shimmer.
-- No HUD, economy, NPCs, collectibles, damage, or gameplay systems.
local RunService = game:GetService("RunService")
local map = workspace:WaitForChild("OceanMap")
local decor = map:WaitForChild("WallDecor")
local seabed = map:WaitForChild("SeabedDecor")
local rng = Random.new(1827)
local kelp, glints, sources = {}, {}, {}

for _, model in map:GetDescendants() do
	if model:IsA("Model") and model.Name == "KelpBlade" then
		local origin = model:FindFirstChild("SwayOrigin")
		if origin then
			local facing = model:FindFirstChild("SwayFacing")
			local pivot = CFrame.new(origin.Value) * CFrame.Angles(0, facing and facing.Value or 0, 0)
			local parts = {}
			for _, part in model:GetChildren() do
				if part:IsA("BasePart") then
					table.insert(parts, {part = part, relative = pivot:ToObjectSpace(part.CFrame)})
				end
			end
			table.insert(kelp, {pivot = pivot, parts = parts, phase = rng:NextNumber(0, math.pi * 2), speed = rng:NextNumber(0.7, 1.15)})
		end
	end
end

for _, part in map:GetDescendants() do
	if part:IsA("BasePart") and part.Name == "CausticStroke" then
		table.insert(glints, {part = part, base = part.CFrame, phase = rng:NextNumber(0, math.pi * 2)})
	elseif part:IsA("BasePart") and part.Name == "BubbleSource" then
		table.insert(sources, {position = part.Position, height = part.RiseHeight.Value})
	end
end

local preview = map:FindFirstChild("BubblePreview")
if preview then
	for _, part in preview:GetDescendants() do
		if part:IsA("BasePart") then part.LocalTransparencyModifier = 1 end
	end
end

local localFX = Instance.new("Folder")
localFX.Name = "OceanLocalBubbles"
localFX.Parent = workspace
local bubbles = {}
for _ = 1, 112 do
	local p = Instance.new("Part")
	p.Name = "Bubble"
	p.Shape = Enum.PartType.Ball
	p.Anchored = true
	p.CanCollide, p.CanTouch, p.CanQuery = false, false, false
	p.CastShadow = false
	p.Material = Enum.Material.Glass
	p.Color = Color3.fromRGB(157, 246, 255)
	p.Transparency = 1
	p.Parent = localFX
	local sparkle = p:Clone()
	sparkle.Name = "BubbleHighlight"
	sparkle.Material = Enum.Material.Neon
	sparkle.Color = Color3.fromRGB(224, 255, 255)
	sparkle.Parent = localFX
	table.insert(bubbles, {part = p, sparkle = sparkle, age = 100, duration = 0})
end

local t, accumulator, sourceAccumulator = 0, 0, 1
local nearby = {}
local function near(a, b, range)
	return (a - b).Magnitude < range
end

local connection
connection = RunService.Heartbeat:Connect(function(dt)
	if not map.Parent then
		connection:Disconnect()
		localFX:Destroy()
		return
	end
	t += dt
	accumulator += dt
	if accumulator < 1 / 30 then return end
	local step = accumulator
	accumulator = 0
	local camera = workspace.CurrentCamera
	if not camera then return end
	local eye = camera.CFrame.Position

	for _, blade in kelp do
		if near(blade.pivot.Position, eye, 220) then
			local pose = blade.pivot * CFrame.Angles(math.sin(t * blade.speed + blade.phase) * 0.02, 0, math.sin(t * blade.speed * 0.83 + blade.phase) * 0.09)
			for _, entry in blade.parts do entry.part.CFrame = pose * entry.relative end
		end
	end
	for _, glint in glints do
		if near(glint.base.Position, eye, 240) then
			glint.part.Transparency = 0.69 + math.sin(t * 0.85 + glint.phase) * 0.18
			-- Move only vertically so the light stays on its wall face.
			glint.part.CFrame = glint.base + Vector3.new(0, math.sin(t * 0.55 + glint.phase) * 0.65, 0)
		end
	end

	sourceAccumulator += step
	if sourceAccumulator > 0.7 then
		sourceAccumulator = 0
		table.clear(nearby)
		for _, source in sources do
			if near(source.position, eye, 180) then table.insert(nearby, source) end
		end
	end
	for _, bubble in bubbles do
		bubble.age += step
		if bubble.age >= bubble.duration then
			if #nearby == 0 then
				bubble.part.Transparency, bubble.sparkle.Transparency = 1, 1
				continue
			end
			local source = nearby[rng:NextInteger(1, #nearby)]
			bubble.origin = source.position + Vector3.new(rng:NextNumber(-0.55, 0.55), 0, rng:NextNumber(-0.55, 0.55))
			bubble.height = source.height
			bubble.duration = rng:NextNumber(8, 13)
			bubble.age = rng:NextNumber(0, bubble.duration * 0.85)
			bubble.phase = rng:NextNumber(0, math.pi * 2)
			bubble.size = rng:NextNumber(0.3, 0.82)
		end
		local alpha = bubble.age / bubble.duration
		local size = bubble.size * (0.65 + alpha * 0.4)
		bubble.part.Size = Vector3.one * size
		bubble.part.Position = bubble.origin + Vector3.new(math.sin(t * 1.1 + bubble.phase) * 0.45, alpha * bubble.height, math.cos(t + bubble.phase) * 0.45)
		local fade = math.min(alpha * 7, (1 - alpha) * 7, 1)
		bubble.part.Transparency = 1 - fade * 0.4
		bubble.sparkle.Size = Vector3.one * size * 0.18
		bubble.sparkle.Position = bubble.part.Position + Vector3.new(-size * 0.2, size * 0.23, -size * 0.31)
		bubble.sparkle.Transparency = 1 - fade * 0.72
	end
end)
]]></ProtectedString><bool name="Disabled">false</bool></Properties></Item><Item class="LocalScript" referent="OM21608"><Properties><string name="Name">OceanPlayer</string><ProtectedString name="Source"><![CDATA[-- Neutral-depth swimming, camera immersion and mouth bubbles. R6 / R15.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local Lighting = game:GetService("Lighting")
local Environment = require(game:GetService("ReplicatedStorage"):WaitForChild("OceanEnvironment"))
local player = Players.LocalPlayer
local map = workspace:WaitForChild("OceanMap")
local rng = Random.new(4816)
local UP, DOWN = "OceanSwimUp", "OceanSwimDown"
local keysUp, keysDown = {}, {}
local active = false
local character, humanoid, root, attachment, depthVelocity
local jumpingWasEnabled = true
local connections = {}
local alive = true

local function clearInput()
	table.clear(keysUp)
	table.clear(keysDown)
end

local function onAction(action, state, input)
	if not active then return Enum.ContextActionResult.Pass end
	local held = action == UP and keysUp or keysDown
	local key = input.KeyCode ~= Enum.KeyCode.Unknown and input.KeyCode or input.UserInputType
	if state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
		held[key] = nil
	elseif UserInputService:GetFocusedTextBox() then
		clearInput()
		return Enum.ContextActionResult.Pass
	elseif state == Enum.UserInputState.Begin then
		held[key] = true
	end
	return Enum.ContextActionResult.Sink
end

local function setActive(value)
	if value == active then return end
	active = value
	clearInput()
	if depthVelocity then depthVelocity.Enabled = value end
	if value then
		jumpingWasEnabled = humanoid:GetStateEnabled(Enum.HumanoidStateType.Jumping)
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
		humanoid.Jump = false
		ContextActionService:BindActionAtPriority(UP, onAction, true, 3001, Enum.KeyCode.Space, Enum.KeyCode.E, Enum.KeyCode.ButtonA)
		ContextActionService:BindActionAtPriority(DOWN, onAction, true, 3001, Enum.KeyCode.LeftControl, Enum.KeyCode.RightControl, Enum.KeyCode.Q, Enum.KeyCode.ButtonB)
		ContextActionService:SetTitle(UP, "Вверх")
		ContextActionService:SetTitle(DOWN, "Вниз")
		ContextActionService:SetPosition(UP, UDim2.fromScale(0.73, 0.38))
		ContextActionService:SetPosition(DOWN, UDim2.fromScale(0.54, 0.61))
		if not UserInputService:GetFocusedTextBox() then
			for _, key in {Enum.KeyCode.Space, Enum.KeyCode.E} do
				if UserInputService:IsKeyDown(key) then keysUp[key] = true end
			end
			for _, key in {Enum.KeyCode.LeftControl, Enum.KeyCode.RightControl, Enum.KeyCode.Q} do
				if UserInputService:IsKeyDown(key) then keysDown[key] = true end
			end
		end
	else
		ContextActionService:UnbindAction(UP)
		ContextActionService:UnbindAction(DOWN)
		if humanoid and humanoid.Parent then
			humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, jumpingWasEnabled)
		end
	end
end

local function releaseCharacter()
	setActive(false)
	if depthVelocity then depthVelocity:Destroy() end
	if attachment then attachment:Destroy() end
	character, humanoid, root, attachment, depthVelocity = nil, nil, nil, nil, nil
end

local function bindCharacter(nextCharacter)
	releaseCharacter()
	character = nextCharacter
	local nextHumanoid = nextCharacter:WaitForChild("Humanoid", 10)
	local nextRoot = nextCharacter:WaitForChild("HumanoidRootPart", 10)
	if not alive or character ~= nextCharacter or not nextHumanoid or not nextRoot then return end
	humanoid, root = nextHumanoid, nextRoot
	attachment = Instance.new("Attachment")
	attachment.Name = "OceanDepthAttachment"
	attachment.Parent = root
	depthVelocity = Instance.new("LinearVelocity")
	depthVelocity.Name = "OceanDepthControl"
	depthVelocity.Enabled = false
	depthVelocity.Attachment0 = attachment
	depthVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
	-- Only Y is constrained. Roblox still controls horizontal movement,
	-- character animation, camera and normal collision response.
	depthVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Line
	depthVelocity.LineDirection = Vector3.yAxis
	depthVelocity.LineVelocity = 0
	depthVelocity.ForceLimitsEnabled = true
	depthVelocity.ForceLimitMode = Enum.ForceLimitMode.Magnitude
	depthVelocity.MaxForce = root.AssemblyMass * workspace.Gravity * 4
	depthVelocity.Parent = root
end

table.insert(connections, player.CharacterAdded:Connect(bindCharacter))
table.insert(connections, player.CharacterRemoving:Connect(function(removed)
	if removed == character then releaseCharacter() end
end))
table.insert(connections, UserInputService.WindowFocusReleased:Connect(clearInput))
table.insert(connections, UserInputService.TextBoxFocused:Connect(clearInput))
table.insert(connections, GuiService.MenuOpened:Connect(clearInput))
if player.Character then task.spawn(bindCharacter, player.Character) end

table.insert(connections, RunService.PreSimulation:Connect(function()
	local canSwim = humanoid and root and root.Parent and depthVelocity
		and humanoid.Health > 0 and not humanoid.Sit and not root.Anchored
		and map:GetAttribute("WaterBaked")
		and Environment.IsSubmerged(root.Position, active and -0.35 or 0.15)
	setActive(canSwim == true)
	if active then
		if UserInputService:GetFocusedTextBox() then clearInput() end
		humanoid.Jump = false
		depthVelocity.MaxForce = root.AssemblyMass * workspace.Gravity * 4
		depthVelocity.LineVelocity = Environment.VerticalTarget(next(keysUp) ~= nil, next(keysDown) ~= nil)
	end
end))

local tint = Instance.new("ColorCorrectionEffect")
tint.Name = "OceanImmersionTint"
tint.Parent = Lighting
local blur = Instance.new("BlurEffect")
blur.Name = "OceanImmersionSoftness"
blur.Size = 0
blur.Parent = Lighting
local veil = Instance.new("ScreenGui")
veil.Name = "OceanImmersionEdges"
veil.IgnoreGuiInset = true
veil.ResetOnSpawn = false
veil.DisplayOrder = -10
veil.Parent = player:WaitForChild("PlayerGui")
local edges = {}
for _, edge in {
	{UDim2.fromScale(0, 0), UDim2.fromScale(0.13, 1), 0},
	{UDim2.fromScale(0.87, 0), UDim2.fromScale(0.13, 1), 180},
	{UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.15), 90},
	{UDim2.fromScale(0, 0.85), UDim2.fromScale(1, 0.15), 270},
} do
	local frame = Instance.new("Frame")
	frame.BorderSizePixel = 0
	frame.Position, frame.Size = edge[1], edge[2]
	frame.BackgroundColor3 = Color3.fromRGB(25, 104, 131)
	frame.BackgroundTransparency = 1
	frame.Parent = veil
	local gradient = Instance.new("UIGradient")
	gradient.Rotation = edge[3]
	gradient.Transparency = NumberSequence.new(0.1, 1)
	gradient.Parent = frame
	table.insert(edges, frame)
end

-- Local pool, also rendering nearby players' breath. No asset uploads or
-- network messages are required. Bubbles leave the mouth in world space.
local effects = Instance.new("Folder")
effects.Name = "OceanBreathBubbles"
effects.Parent = workspace
local bubbles = {}
for _ = 1, 72 do
	local sphere = Instance.new("Part")
	sphere.Name = "MouthBubble"
	sphere.Shape = Enum.PartType.Ball
	sphere.Anchored = true
	sphere.CanCollide, sphere.CanTouch, sphere.CanQuery = false, false, false
	sphere.CastShadow = false
	sphere.Material = Enum.Material.SmoothPlastic
	sphere.Color = Color3.fromRGB(174, 233, 240)
	sphere.Transparency = 1
	sphere.Parent = effects
	local shine = sphere:Clone()
	shine.Name = "MouthBubbleHighlight"
	shine.Material = Enum.Material.Neon
	shine.Color = Color3.fromRGB(224, 250, 255)
	shine.Parent = effects
	table.insert(bubbles, {part = sphere, shine = shine, age = 10, life = 0})
end
local breathTimers = {}
local poolIndex = 0
local function emitBreath(head, mouth)
	poolIndex = poolIndex % #bubbles + 1
	local bubble = bubbles[poolIndex]
	bubble.age, bubble.life = 0, rng:NextNumber(1.5, 2.4)
	bubble.origin = mouth
	bubble.velocity = head.CFrame.LookVector * rng:NextNumber(0.6, 1.2) + Vector3.new(0, rng:NextNumber(0.9, 1.5), 0)
	bubble.phase, bubble.size = rng:NextNumber(0, math.pi * 2), rng:NextNumber(0.11, 0.23)
end

local elapsed, accumulator, immersion = 0, 0, 0
table.insert(connections, Players.PlayerRemoving:Connect(function(other) breathTimers[other] = nil end))
table.insert(connections, RunService.Heartbeat:Connect(function(dt)
	if not alive then return end
	elapsed += dt
	accumulator += dt
	if accumulator < 1 / 30 then return end
	local step = accumulator
	accumulator = 0
	local camera = workspace.CurrentCamera
	if not camera then return end
	local eye = camera.CFrame.Position
	local wet = map:GetAttribute("WaterBaked") and Environment.IsSubmerged(eye, 0.12)
	immersion += ((wet and 1 or 0) - immersion) * (1 - math.exp(-step * 7))
	if immersion < 0.001 then immersion = 0 end
	local depth = math.clamp(-eye.Y / 164, 0, 1)
	tint.TintColor = Color3.new(1, 1, 1):Lerp(Color3.fromRGB(188 - depth * 13, 229 - depth * 8, 240), immersion)
	tint.Brightness = -(0.025 + depth * 0.025) * immersion
	tint.Contrast, tint.Saturation = 0.04 * immersion, -0.09 * immersion
	blur.Size = (0.6 + depth * 0.5) * immersion
	veil.Enabled = immersion > 0
	for _, frame in edges do frame.BackgroundTransparency = 1 - immersion * (0.18 + math.sin(elapsed * 0.7) * 0.015) end

	for _, other in Players:GetPlayers() do
		local rig = other.Character
		local head = rig and rig:FindFirstChild("Head")
		local person = rig and rig:FindFirstChildOfClass("Humanoid")
		if head and person and person.Health > 0 and (head.Position - eye).Magnitude < 130 then
			local mouth = head.CFrame:PointToWorldSpace(Vector3.new(0, -head.Size.Y * 0.18, -head.Size.Z * 0.5 - 0.1))
			if map:GetAttribute("WaterBaked") and Environment.IsSubmerged(mouth, 0.08) then
				breathTimers[other] = (breathTimers[other] or 0) + step
				if breathTimers[other] >= 0.18 then
					breathTimers[other] = 0
					emitBreath(head, mouth)
				end
			else breathTimers[other] = 0 end
		else breathTimers[other] = nil end
	end
	for _, bubble in bubbles do
		bubble.age += step
		if bubble.age >= bubble.life then
			bubble.part.Transparency, bubble.shine.Transparency = 1, 1
			continue
		end
		local age = bubble.age
		local pos = bubble.origin + bubble.velocity * age + Vector3.new(math.sin(age * 3 + bubble.phase) * age * 0.08, age * age * 0.6, 0)
		if not Environment.IsSubmerged(pos, 0.025) then
			bubble.age = bubble.life
			bubble.part.Transparency, bubble.shine.Transparency = 1, 1
			continue
		end
		local ratio = age / bubble.life
		local size = bubble.size * (1 + ratio * 0.65)
		local opacity = math.min(age * 12, (1 - ratio) * 5, 1)
		bubble.part.Size, bubble.part.Position = Vector3.one * size, pos
		bubble.part.Transparency = 1 - opacity * 0.5
		bubble.shine.Size = Vector3.one * size * 0.22
		bubble.shine.Position = pos + Vector3.new(-size * 0.2, size * 0.22, -size * 0.3)
		bubble.shine.Transparency = 1 - opacity * 0.85
	end
end))

local function cleanup()
	if not alive then return end
	alive = false
	releaseCharacter()
	for _, connection in connections do connection:Disconnect() end
	effects:Destroy()
	tint:Destroy()
	blur:Destroy()
	veil:Destroy()
end
table.insert(connections, map.AncestryChanged:Connect(function()
	if not map:IsDescendantOf(workspace) then cleanup() end
end))
script.Destroying:Connect(cleanup)
]]></ProtectedString><bool name="Disabled">false</bool></Properties></Item></Item></Item></roblox>