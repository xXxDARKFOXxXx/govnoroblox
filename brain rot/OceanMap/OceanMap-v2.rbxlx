>0</token><token name="FrontSurface">0</token><token name="BackSurface">0</token></Properties></Item><Item class="Part" referent="OM14420"><Properties><string name="Name">WaterSurfacePreview</string><Vector3 name="size"><X>128</X><Y>0.1</Y><Z>192</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>0</Y><Z>480</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4282304728</Color3uint8><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">false</bool><bool name="CastShadow">false</bool><token name="Material">1568</token><token name="shape">1</token><float name="Transparency">0.65</float><float name="Reflectance">0.04</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="LeftSurface">0</token><token name="RightSurface">0</token><token name="FrontSurface">0</token><token name="BackSurface">0</token></Properties></Item><Item class="Part" referent="OM14421"><Properties><string name="Name">WaterSurfacePreview</string><Vector3 name="size"><X>128</X><Y>0.1</Y><Z>192</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>0</Y><Z>672</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4282304728</Color3uint8><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">false</bool><bool name="CastShadow">false</bool><token name="Material">1568</token><token name="shape">1</token><float name="Transparency">0.65</float><float name="Reflectance">0.04</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="LeftSurface">0</token><token name="RightSurface">0</token><token name="FrontSurface">0</token><token name="BackSurface">0</token></Properties></Item><Item class="Part" referent="OM14422"><Properties><string name="Name">WaterSurfacePreview</string><Vector3 name="size"><X>128</X><Y>0.1</Y><Z>192</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>0</Y><Z>864</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4282304728</Color3uint8><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">false</bool><bool name="CastShadow">false</bool><token name="Material">1568</token><token name="shape">1</token><float name="Transparency">0.65</float><float name="Reflectance">0.04</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="LeftSurface">0</token><token name="RightSurface">0</token><token name="FrontSurface">0</token><token name="BackSurface">0</token></Properties></Item></Item></Item></Item><Item class="Lighting" referent="OM14433"><Properties><string name="Name">Lighting</string><Color3 name="Ambient"><R>0.5372549019607843</R><G>0.6392156862745098</G><B>0.7058823529411765</B></Color3><Color3 name="OutdoorAmbient"><R>0.6470588235294118</R><G>0.7372549019607844</G><B>0.7843137254901961</B></Color3><float name="Brightness">2</float><float name="ClockTime">14</float><float name="GeographicLatitude">23</float><bool name="GlobalShadows">true</bool><float name="EnvironmentDiffuseScale">0.7</float><float name="EnvironmentSpecularScale">0.45</float><Color3 name="FogColor"><R>0.6039215686274509</R><G>0.8549019607843137</G><B>0.8980392156862745</B></Color3><float name="FogStart">700</float><float name="FogEnd">2600</float></Properties><Item class="Atmosphere" referent="OM14431"><Properties><string name="Name">OceanAir</string><float name="Density">0.16</float><float name="Offset">0.12</float><Color3 name="Color"><R>0.7333333333333333</R><G>0.9137254901960784</G><B>0.9568627450980393</B></Color3><Color3 name="Decay"><R>0.48627450980392156</R><G>0.7294117647058823</G><B>0.8352941176470589</B></Color3><float name="Glare">0.08</float><float name="Haze">0.6</float></Properties></Item><Item class="BloomEffect" referent="OM14432"><Properties><string name="Name">SoftWaterGlow</string><float name="Intensity">0.12</float><float name="Size">20</float><float name="Threshold">1.5</float></Properties></Item></Item><Item class="ServerStorage" referent="OM14435"><Properties><string name="Name">ServerStorage</string></Properties><Item class="ModuleScript" referent="OM14434"><Properties><string name="Name">OceanWater</string><ProtectedString name="Source"><![CDATA[-- Real, swimmable Terrain water. Also callable from Studio's Command Bar.
-- Only writes inside this map's canal; never clears the user's Terrain.
local Water = {}
Water.SurfaceY = 0
Water.Width = 128
Water.SectionLength = 192
Water.FloorLevels = {4, -20, -44, -76, -116, -164}

function Water.FloorAt(z)
	local section = math.clamp(math.floor(z / Water.SectionLength) + 1, 1, 5)
	local alpha = math.clamp((z - (section - 1) * Water.SectionLength) / Water.SectionLength, 0, 1)
	return Water.FloorLevels[section] + (Water.FloorLevels[section + 1] - Water.FloorLevels[section]) * alpha
end

function Water.Build()
	local terrain = workspace.Terrain
	terrain.WaterColor = Color3.fromRGB(35, 188, 211)
	terrain.WaterTransparency = 0.72
	terrain.WaterReflectance = 0.08
	terrain.WaterWaveSize = 0.13
	terrain.WaterWaveSpeed = 7
	-- All bounds align with the 4-stud terrain grid. Water extends below
	-- the solid sloping floor, so every exposed point stays swimmable.
	for z = 0, 956, 4 do
		local floor = math.min(Water.FloorAt(z), Water.FloorAt(z + 4))
		local bottom = math.floor((floor - 8) / 4) * 4
		terrain:FillBlock(CFrame.new(0, bottom / 2, z + 2), Vector3.new(128, -bottom, 4), Enum.Material.Water)
	end
	local map = workspace:FindFirstChild("OceanMap")
	if map then
		map:SetAttribute("WaterBaked", true)
		local preview = map:FindFirstChild("WaterPreview")
		if preview then preview:Destroy() end
	end
end

return Water
]]></ProtectedString></Properties></Item></Item><Item class="ServerScriptService" referent="OM14437"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="OM14436"><Properties><string name="Name">OceanStart</string><ProtectedString name="Source"><![CDATA[local map = workspace:WaitForChild("OceanMap")
if not map:GetAttribute("WaterBaked") then
	require(game:GetService("ServerStorage"):WaitForChild("OceanWater")).Build()
end
]]></ProtectedString><bool name="Disabled">false</bool></Properties></Item></Item><Item class="StarterPlayer" referent="OM14440"><Properties><string name="Name">StarterPlayer</string><float name="CameraMaxZoomDistance">80</float><float name="CameraMinZoomDistance">0.5</float></Properties><Item class="StarterPlayerScripts" referent="OM14439"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="OM14438"><Properties><string name="Name">OceanAmbience</string><ProtectedString name="Source"><![CDATA[-- Ambient details only: swaying wall kelp, ascending bubbles, wall shimmer.
-- No HUD, economy, NPCs, collectibles, damage, or gameplay systems.
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local map = workspace:WaitForChild("OceanMap")
local decor = map:WaitForChild("WallDecor")
local rng = Random.new(1827)
local kelp, glints, sources = {}, {}, {}

for _, model in decor:GetChildren() do
	if model:IsA("Model") and model.Name == "KelpBlade" then
		local origin = model:FindFirstChild("SwayOrigin")
		if origin then
			local facing = model:FindFirstChild("SwayFacing")
			local pivot = CFrame.new(origin.Value) * CFrame.Angles(0, facing and facing.Value or 0, 0)
			local parts = {}
			for _, part in model:GetChildren() do
				if part:IsA("BasePart") then
					table.insert(parts, {part = part, relative = pivot:ToObjectSpace(part.CFrame)})
				end
			end
			table.insert(kelp, {pivot = pivot, parts = parts, phase = rng:NextNumber(0, math.pi * 2), speed = rng:NextNumber(0.7, 1.15)})
		end
	end
end

for _, part in decor:GetDescendants() do
	if part:IsA("BasePart") and part.Name == "CausticStroke" then
		table.insert(glints, {part = part, base = part.CFrame, phase = rng:NextNumber(0, math.pi * 2)})
	elseif part:IsA("BasePart") and part.Name == "BubbleSource" then
		table.insert(sources, {position = part.Position, height = part.RiseHeight.Value})
	end
end

local preview = map:FindFirstChild("BubblePreview")
if preview then
	for _, part in preview:GetDescendants() do
		if part:IsA("BasePart") then part.LocalTransparencyModifier = 1 end
	end
end

local localFX = Instance.new("Folder")
localFX.Name = "OceanLocalBubbles"
localFX.Parent = workspace
local bubbles = {}
for _ = 1, 112 do
	local p = Instance.new("Part")
	p.Name = "Bubble"
	p.Shape = Enum.PartType.Ball
	p.Anchored = true
	p.CanCollide, p.CanTouch, p.CanQuery = false, false, false
	p.CastShadow = false
	p.Material = Enum.Material.Glass
	p.Color = Color3.fromRGB(157, 246, 255)
	p.Transparency = 1
	p.Parent = localFX
	local sparkle = p:Clone()
	sparkle.Name = "BubbleHighlight"
	sparkle.Material = Enum.Material.Neon
	sparkle.Color = Color3.fromRGB(224, 255, 255)
	sparkle.Parent = localFX
	table.insert(bubbles, {part = p, sparkle = sparkle, age = 100, duration = 0})
end

local tint = Instance.new("ColorCorrectionEffect")
tint.Name = "OceanDepthTint"
tint.Parent = Lighting
local t, accumulator, sourceAccumulator = 0, 0, 1
local nearby = {}
local function near(a, b, range)
	return (a - b).Magnitude < range
end

local connection
connection = RunService.Heartbeat:Connect(function(dt)
	if not map.Parent then
		connection:Disconnect()
		localFX:Destroy()
		tint:Destroy()
		return
	end
	t += dt
	accumulator += dt
	if accumulator < 1 / 30 then return end
	local step = accumulator
	accumulator = 0
	local camera = workspace.CurrentCamera
	if not camera then return end
	local eye = camera.CFrame.Position

	for _, blade in kelp do
		if near(blade.pivot.Position, eye, 220) then
			local pose = blade.pivot * CFrame.Angles(math.sin(t * blade.speed + blade.phase) * 0.02, 0, math.sin(t * blade.speed * 0.83 + blade.phase) * 0.09)
			for _, entry in blade.parts do entry.part.CFrame = pose * entry.relative end
		end
	end
	for _, glint in glints do
		if near(glint.base.Position, eye, 240) then
			glint.part.Transparency = 0.69 + math.sin(t * 0.85 + glint.phase) * 0.18
			-- Move only vertically so the light stays on its wall face.
			glint.part.CFrame = glint.base + Vector3.new(0, math.sin(t * 0.55 + glint.phase) * 0.65, 0)
		end
	end

	sourceAccumulator += step
	if sourceAccumulator > 0.7 then
		sourceAccumulator = 0
		table.clear(nearby)
		for _, source in sources do
			if near(source.position, eye, 180) then table.insert(nearby, source) end
		end
	end
	for _, bubble in bubbles do
		bubble.age += step
		if bubble.age >= bubble.duration then
			if #nearby == 0 then
				bubble.part.Transparency, bubble.sparkle.Transparency = 1, 1
				continue
			end
			local source = nearby[rng:NextInteger(1, #nearby)]
			bubble.origin = source.position + Vector3.new(rng:NextNumber(-0.55, 0.55), 0, rng:NextNumber(-0.55, 0.55))
			bubble.height = source.height
			bubble.duration = rng:NextNumber(8, 13)
			bubble.age = rng:NextNumber(0, bubble.duration * 0.85)
			bubble.phase = rng:NextNumber(0, math.pi * 2)
			bubble.size = rng:NextNumber(0.3, 0.82)
		end
		local alpha = bubble.age / bubble.duration
		local size = bubble.size * (0.65 + alpha * 0.4)
		bubble.part.Size = Vector3.one * size
		bubble.part.Position = bubble.origin + Vector3.new(math.sin(t * 1.1 + bubble.phase) * 0.45, alpha * bubble.height, math.cos(t + bubble.phase) * 0.45)
		local fade = math.min(alpha * 7, (1 - alpha) * 7, 1)
		bubble.part.Transparency = 1 - fade * 0.4
		bubble.sparkle.Size = Vector3.one * size * 0.18
		bubble.sparkle.Position = bubble.part.Position + Vector3.new(-size * 0.2, size * 0.23, -size * 0.31)
		bubble.sparkle.Transparency = 1 - fade * 0.72
	end

	local inCanal = eye.Z >= 0 and eye.Z <= 960 and math.abs(eye.X) < 64 and eye.Y < -0.5
	local depth = inCanal and math.clamp(-eye.Y / 164, 0, 1) or 0
	local goal = inCanal and Color3.fromRGB(210 - depth * 24, 244 - depth * 17, 255) or Color3.new(1, 1, 1)
	tint.TintColor = tint.TintColor:Lerp(goal, math.min(1, step * 3))
	tint.Brightness = tint.Brightness + ((-depth * 0.035) - tint.Brightness) * math.min(1, step * 3)
end)
]]></ProtectedString><bool name="Disabled">false</bool></Properties></Item></Item></Item></roblox>