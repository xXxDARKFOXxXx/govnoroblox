tem class="Part" referent="OM14122"><Properties><string name="Name">Bubble</string><Vector3 name="size"><X>0.9833333333333336</X><Y>0.9833333333333336</Y><Z>0.9833333333333336</Z></Vector3><CoordinateFrame name="CFrame"><X>127.34377560755652</X><Y>15.260000000000002</Y><Z>-156.93568153228563</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4289591037</Color3uint8><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">false</bool><bool name="CastShadow">false</bool><token name="Material">1568</token><token name="shape">0</token><float name="Transparency">0.6</float><float name="Reflectance">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="LeftSurface">0</token><token name="RightSurface">0</token><token name="FrontSurface">0</token><token name="BackSurface">0</token></Properties></Item><Item class="Part" referent="OM14123"><Properties><string name="Name">BubbleHighlight</string><Vector3 name="size"><X>0.1671666666666667</X><Y>0.1671666666666667</Y><Z>0.1671666666666667</Z></Vector3><CoordinateFrame name="CFrame"><X>127.12744227422318</X><Y>15.486166666666668</Y><Z>-157.23068153228562</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3uint8 name="Color3uint8">4293001215</Color3uint8><bool name="Anchored">true</bool><bool name="CanCollide">false</bool><bool name="CanTouch">false</bool><bool name="CanQuery">false</bool><bool name="CastShadow">false</bool><token name="Material">288</token><token name="shape">0</token><float name="Transparency">0.15</float><float name="Reflectance">0</float><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="LeftSurface">0</token><token name="RightSurface">0</token><token name="FrontSurface">0</token><t