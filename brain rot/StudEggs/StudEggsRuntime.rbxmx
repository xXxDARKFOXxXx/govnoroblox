		lights = {
			{
				color = rgb(128, 255, 223),
				strength = 2.35,
				range = 8.4,
				pulse = 0.64,
				at = "EggCoreFX",
			},
			{
				color = rgb(255, 218, 142),
				strength = 1.3,
				range = 6.3,
				pulse = 0.55,
				at = "EggTopFX",
			},
		},
	},
}

local rigs = {}
local pending = {}
local tau = 2 * math.pi
local sin, cos, rad = math.sin, math.cos, math.rad

local function makeEmitter(attachment, style, scale)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = style.name
	emitter.Enabled = false
	emitter.Texture = style.texture
	emitter.Rate = style.rate
	emitter.Lifetime = NumberRange.new(style.life[1], style.life[2])
	emitter.Speed = NumberRange.new(style.speed[1] * scale, style.speed[2] * scale)
	emitter.SpreadAngle = Vector2.new(style.spread, style.spread)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Color = ColorSequence.new(style.first, style.last)
	emitter.LightInfluence = 0
	emitter.LightEmission = style.emission or 0.66
	emitter.Drag = 0.65
	emitter.Acceleration = Vector3.new(0, (style.accel or 0.48) * scale, 0)
	emitter.Rotation = NumberRange.new(-180, 180)
	emitter.RotSpeed = NumberRange.new(-58, 58)
	local size = style.size * scale
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, size * 0.50),
		NumberSequenceKeypoint.new(0.24, size),
		NumberSequenceKeypoint.new(1, size * 0.65),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.13, 0.08),
		NumberSequenceKeypoint.new(0.56, 0.22),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Parent = attachment
	return emitter
end

local function register(root)
	local style = eggs[root.Name]
	local mesh = root:FindFirstAncestorWhichIsA("MeshPart")
	if not style or not mesh or rigs[root] or not root:IsDescendantOf(Workspace) then
		return
	end
	local bones = {}
	for _, name in style.joints do
		local bone = root:FindFirstChild(name, true)
		if not bone or not bone:IsA("Bone") then
			return
		end
		bones[name] = bone
	end
	local up = root.WorldCFrame:VectorToObjectSpace(Vector3.yAxis)
	local scale = (bones.EggTopFX.WorldPosition - root.WorldPosition).Magnitude / style.measure
	scale = math.clamp(scale, 0.08, 16)
	local visualScale = math.clamp(scale, 0.25, 5)
	local anchors, emitters, lights = {}, {}, {}
	for _, name in {"EggCoreFX", "EggTopFX"} do
		local attachment = Instance.new("Attachment")
		attachment.Name = "StudEggEffects_" .. name
		attachment.Parent = mesh
		attachment.WorldCFrame = CFrame.new(bones[name].WorldPosition)
		anchors[name] = attachment
	end
	for i, config in style.fx do
		emitters[i] = makeEmitter(anchors[config.at], config, visualScale)
	end
	for i, config in style.lights do
		local light = Instance.new("PointLight")
		light.Name = "StudEggLight"
		light.Enabled = false
		light.Color = config.color
		light.Range = math.clamp(config.range * visualScale, 1, 26)
		light.Parent = anchors[config.at]
		lights[i] = light
	end
	local p = root.WorldPosition
	rigs[root] = {
		mesh = mesh,
		bones = bones,
		style = style,
		anchors = anchors,
		emitters = emitters,
		lights = lights,
		up = up,
		scale = scale,
		phase = (p.X * 0.17 + p.Z * 0.13) % 1,
		visible = false,
	}
end

local function consider(instance)
	local current = instance
	while current and current:IsA("Bone") do
		if eggs[current.Name] then
			local root = current
			if not rigs[root] and not pending[root] then
				pending[root] = true
				task.defer(function()
					pending[root] = nil
					register(root)
				end)
			end
			return
		end
		current = current.Parent
	end
end

Workspace.DescendantAdded:Connect(consider)
for _, instance in Workspace:GetDescendants() do
	consider(instance)
end

local function setVisible(rig, visible)
	rig.visible = visible
	rig.lastCycle = nil
	for _, emitter in rig.emitters do
		emitter.Enabled = visible
		if not visible then
			emitter:Clear()
		end
	end
	for _, light in rig.lights do
		light.Enabled = visible
	end
end

local function animate(root, rig, seconds)
	local style, bones = rig.style, rig.bones
	local cycle = seconds / style.period + rig.phase
	local whole = math.floor(cycle)
	local t = (cycle - whole) * tau
	local height = style.bob * rig.scale * (0.5 - 0.5 * cos(t))
	root.Transform = CFrame.new(rig.up * height) * CFrame.Angles(
		rad(style.roll * sin(t + 0.36)), rad(style.twist * sin(t - 0.4)), rad(style.pitch * sin(t - 0.2))
	)
	for name, tracks in style.tracks do
		local x, y, z = 0, 0, 0
		for _, wave in tracks do
			local amplitude = sin(wave[4] * t + wave[5])
			x += wave[1] * amplitude
			y += wave[2] * amplitude
			z += wave[3] * amplitude
		end
		bones[name].Transform = CFrame.Angles(rad(x), rad(y), rad(z))
	end
	for name, turns in style.spin do
		bones[name].Transform = CFrame.Angles(0, t * turns, 0)
	end
	for name, anchor in rig.anchors do
		anchor.WorldCFrame = CFrame.new(bones[name].TransformedWorldCFrame.Position)
	end
	for i, light in rig.lights do
		local config = style.lights[i]
		light.Brightness = config.strength + config.pulse * sin(t * 2 - 0.55 + i * 0.46)
	end
	if rig.lastCycle and whole ~= rig.lastCycle then
		for i, config in style.fx do
			if config.burst then
				rig.emitters[i]:Emit(config.burst)
			end
		end
	end
	rig.lastCycle = whole
end

RunService.PreRender:Connect(function()
	local camera = Workspace.CurrentCamera
	local time = Workspace:GetServerTimeNow()
	for root, rig in rigs do
		if not root:IsDescendantOf(Workspace) or not root:IsDescendantOf(rig.mesh) then
			for _, attachment in rig.anchors do
				attachment:Destroy()
			end
			rigs[root] = nil
			consider(root)
			continue
		end
		local visible = camera ~= nil
			and (camera.CFrame.Position - root.WorldPosition).Magnitude <= 145 * math.max(1, rig.scale)
		if visible ~= rig.visible then
			setVisible(rig, visible)
		end
		if visible then
			animate(root, rig, time)
		end
	end
end)

]]></ProtectedString>
    </Properties>
  </Item>
</roblox>