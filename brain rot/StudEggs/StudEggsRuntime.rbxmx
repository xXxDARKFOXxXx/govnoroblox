				name = "CrownRain",
				texture = square,
				at = "EggTopFX",
				rate = 7,
				first = rgb(255, 233, 160),
				last = rgb(255, 178, 103),
				size = 0.15,
				speed = {0.46, 1.42},
				life = {0.53, 1.17},
