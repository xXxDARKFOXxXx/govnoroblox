			{
				name = "OceanFragments",
				texture = square,
				at = "EggCoreFX",
				rate = 15,
				first = rgb(193, 255, 242),
				last = rgb(56, 214, 209),
				size = 0.18,
				speed = {0.46, 1.42},
				life = {0.5, 1.22},
				spread = 119,
				burst = 16,
			},
			{
				name = "RoyalPearls",
				texture = ring,
				at = "EggCoreFX",
				rate = 10,
				first = rgb(227, 255, 253),
				last = rgb(119, 235, 255),
				size = 0.34,
				speed = {0.4, 1.05},
				life = {0.8, 1.68},
				spread = 88,
				burst = 8,
			},
			{
				name = "OceanFlare",
				texture = sparkle,
				at = "EggCoreFX",
				rate = 9,
				first = rgb(224, 255, 249),
				last = rgb(122, 255, 216),
				size = 0.43,
