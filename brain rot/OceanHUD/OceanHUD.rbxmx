<roblox version="4">
  <Item class="LocalScript" referent="0">
    <Properties>
      <string name="Name">OceanHUD</string>
      <string name="Source"><![CDATA[-- OceanHUD (HUDController) | LocalScript in StarterPlayer > StarterPlayerScripts.
-- Child ModuleScripts: UITheme, UIAssets, UIComponents, UIAnimations,
-- UIDataController, MenuController.
--
-- Layout follows the 1648x928 reference: four candy buttons top-left,
-- coins + speed bottom-left, XP panel bottom-centre. The ScreenGui is built
-- once; data changes only update text, fills and animations.
local Players = game:GetService("Players")

local Theme = require(script.UITheme)
local Assets = require(script.UIAssets)
local C = require(script.UIComponents)
local Anim = require(script.UIAnimations)
local Data = require(script.UIDataController)
local MenuController = require(script.MenuController)

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
if playerGui:FindFirstChild("OceanHUD") then return end

local S = Theme.Size
local connections = {}
local function connect(signal, callback)
	local connection = signal:Connect(callback)
	table.insert(connections, connection)
	return connection
end

local gui = C.new("ScreenGui", playerGui, {
	Name = "OceanHUD", ResetOnSpawn = false, DisplayOrder = 20, IgnoreGuiInset = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling, ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
})
gui:SetAttribute("Version", "3.0.0")
gui:SetAttribute("UseExternalMenus", false)
local openMenuEvent = C.new("BindableEvent", gui, {Name = "OpenMenu"})
local clickSound = C.new("Sound", gui, {Name = "ClickSound", SoundId = Assets.ClickSound, Volume = 0.6})
local root = C.holder(gui, "SafeArea", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1))

local menus = MenuController.new(root, openMenuEvent, clickSound)

---------------------------------------------------------------- left buttons
local NAV_H = S.ButtonH * 4 + S.ButtonGap * 3
local navigation = C.holder(root, "Navigation", UDim2.fromOffset(S.Left, S.Top), UDim2.fromOffset(S.ButtonW, NAV_H))
local navScale = C.new("UIScale", navigation, {Scale = 1})
local buttons = {}
for i, spec in Theme.Buttons do
	local slot = C.holder(navigation, spec.key .. "Slot", UDim2.fromOffset(0, (i - 1) * (S.ButtonH + S.ButtonGap)), UDim2.fromOffset(S.ButtonW, S.ButtonH))
	local scale = C.new("UIScale", slot, {Scale = 1})
	local glow = C.frame(slot, "HoverGlow", {
		AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 18, 1, 18),
		BackgroundColor3 = spec.glow, BackgroundTransparency = 1, ZIndex = 1,
	})
	C.corner(glow, 0.28)
	local _, body = C.plate(slot, "Plate", UDim2.fromOffset(0, 0), UDim2.fromScale(1, 1), {
		top = spec.top, bottom = spec.bottom, edge = spec.edge, rim = Theme.Ink, rimThickness = 3.5, radius = 0.24,
	}, 2)
	local inner = C.holder(body, "WhiteRim", UDim2.fromOffset(4, 4), UDim2.new(1, -8, 1, -8), 5)
	C.corner(inner, 0.22)
	local rim = C.stroke(inner, Theme.White, 2.5, 0.25)
	C.image(body, "Icon", spec.key, UDim2.new(0.5, -43, 0, -1), UDim2.fromOffset(86, 86), 6)
	C.label(body, "Caption", spec.title, {
		Position = UDim2.new(0, -8, 1, -33), Size = UDim2.new(1, 16, 0, 30),
		TextSize = spec.key == "Rebirth" and 18 or 24, ZIndex = 7,
	})
	local button = C.new("TextButton", slot, {
		Name = spec.key, Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1), Selectable = true, ZIndex = 10,
	})
	for _, connection in Anim.bindButton({button = button, scale = scale, rim = rim, glow = glow, sound = clickSound}, function()
		if gui:GetAttribute("UseExternalMenus") then
			openMenuEvent:Fire(spec.key)
		else
			menus:toggle(spec.key)
		end
	end) do
		table.insert(connections, connection)
	end
	buttons[i] = button
end
for i, button in buttons do
	button.NextSelectionUp = buttons[(i - 2) % #buttons + 1]
	button.NextSelectionDown = buttons[i % #buttons + 1]
end

---------------------------------------------------------------- counters
local COIN_OUT = 22 -- how far the round icons stick out to the left
local COUNTERS_W = S.CounterW + COIN_OUT
local COUNTERS_H = S.CounterH * 2 + S.CounterGap
local counters = C.holder(root, "Counters", UDim2.fromOffset(S.Left, 0), UDim2.fromOffset(COUNTERS_W, COUNTERS_H))
local counterScale = C.new("UIScale", counters, {Scale = 1})

local function counter(key, title, y, style, iconName)
	local holder, body = C.plate(counters, key .. "Counter", UDim2.fromOffset(COIN_OUT, y), UDim2.fromOffset(S.CounterW, S.CounterH), {
		top = style.top, bottom = style.bottom, rim = style.rim, rimThickness = 3.5, glow = style.glow, radius = 0.5,
	}, 1)
	local caption = C.label(body, "Caption", title, {
		Position = UDim2.fromOffset(84, 8), Size = UDim2.fromOffset(240, 30), TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 6,
	})
	local value = C.label(body, "Value", "0", {
		Position = UDim2.fromOffset(84, 36), Size = UDim2.fromOffset(244, 46), TextSize = 40,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 6,
	}, nil, {style.valueTop, style.valueBottom})
	local valueScale = C.new("UIScale", value, {Scale = 1})
	local icon = C.image(holder, "Icon", iconName, UDim2.fromOffset(-COIN_OUT - 6, -8), UDim2.fromOffset(104, 104), 8)
	local iconScale = C.new("UIScale", icon, {Scale = 1})
	local shine = C.image(holder, "Shine", "Sparkle", UDim2.fromOffset(-COIN_OUT - 16, -18), UDim2.fromOffset(124, 124), 9)
	shine.ImageTransparency = 1
	return {caption = caption, value = value, valueScale = valueScale, icon = icon, iconScale = iconScale, shine = shine}
end
local coins = counter("Coins", "Монеты", 0, Theme.Coins, "Coin")
local speed = counter("Speed", "Скорость", S.CounterH + S.CounterGap, Theme.Speed, "Speed")
speed.value.Text = "Уровень 1"

---------------------------------------------------------------- XP panel
local xp = C.holder(root, "LevelProgress", UDim2.fromOffset(0, 0), UDim2.fromOffset(S.XPW, S.XPH))
local xpScale = C.new("UIScale", xp, {Scale = 1})
local PANEL_X, PANEL_W, PANEL_Y, PANEL_H = 56, 494, 30, 78
local _, panel = C.plate(xp, "Panel", UDim2.fromOffset(PANEL_X, PANEL_Y), UDim2.fromOffset(PANEL_W, PANEL_H), {
	top = Theme.XP.top, bottom = Theme.XP.bottom, rim = Theme.XP.rim, rimThickness = 3.5, glow = Theme.XP.glow, radius = 0.5,
}, 1)
local TRACK_X, TRACK_W = 84, PANEL_W - 84 - 106
C.label(panel, "Title", "Опыт (XP)", {
	Position = UDim2.fromOffset(TRACK_X, 3), Size = UDim2.fromOffset(TRACK_W, 28), TextSize = 23, ZIndex = 6,
})
local track = C.frame(panel, "Track", {
	Position = UDim2.fromOffset(TRACK_X, 34), Size = UDim2.fromOffset(TRACK_W, 32),
	BackgroundColor3 = Theme.XP.track, ZIndex = 4,
})
C.corner(track, 0.5)
C.stroke(track, Color3.fromRGB(4, 8, 30), 2.5)
local fillClip = C.holder(track, "FillClip", UDim2.fromOffset(3, 3), UDim2.new(1, -6, 1, -6), 5)
fillClip.ClipsDescendants = true
C.corner(fillClip, 0.5)
local fill = C.frame(fillClip, "BlueFill", {Size = UDim2.fromScale(0, 1), Visible = false, ZIndex = 5})
C.corner(fill, 0.5)
C.gradient(fill, Theme.XP.fillTop, Theme.XP.fillBottom)
-- Diagonal stripes as a tiled image: rotated frames would not be clipped by Roblox.
fill.ClipsDescendants = true
local stripes = C.image(fill, "Stripes", "Stripes", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), 6)
stripes.ScaleType = Enum.ScaleType.Tile
stripes.TileSize = UDim2.fromOffset(26, 26)
local fillGloss = C.frame(fill, "Gloss", {Position = UDim2.fromOffset(5, 2), Size = UDim2.new(1, -10, 0.38, 0), BackgroundTransparency = 0.5, ZIndex = 7})
C.corner(fillGloss, 0.5)
local innerGlow = C.holder(track, "InnerGlow", UDim2.fromOffset(1, 1), UDim2.new(1, -2, 1, -2), 8)
C.corner(innerGlow, 0.5)
C.stroke(innerGlow, Theme.XP.rim, 1.5, 0.55)
local progressText = C.label(track, "ProgressText", "0 / 10,000 XP", {Size = UDim2.fromScale(1, 1), TextSize = 20, ZIndex = 9})

-- Star badge, sticking out of the panel's left end.
local badge = C.holder(xp, "LevelBadge", UDim2.fromOffset(-6, -4), UDim2.fromOffset(132, 132), 10)
local badgeScale = C.new("UIScale", badge, {Scale = 1})
local starFlash = C.image(badge, "Flash", "Sparkle", UDim2.fromOffset(-34, -34), UDim2.fromOffset(200, 200), 10)
starFlash.ImageTransparency = 1
C.image(badge, "Star", "LevelStar", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), 11)
C.label(badge, "Caption", "Уровень", {Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 0, 20), TextSize = 17, ZIndex = 12}, Color3.fromRGB(150, 60, 0))
local levelText = C.label(badge, "Level", "1", {Position = UDim2.fromOffset(0, 60), Size = UDim2.new(1, 0, 0, 44), TextSize = 46, ZIndex = 12})
for _, spot in {{-8, 18, 26}, {112, 6, 20}, {120, 96, 16}} do
	C.image(badge, "Sparkle", "Sparkle", UDim2.fromOffset(spot[1], spot[2]), UDim2.fromOffset(spot[3], spot[3]), 12)
end

-- Crown with the next level at the right end.
local nextLevel = C.holder(xp, "NextLevel", UDim2.fromOffset(PANEL_X + PANEL_W - 112, 2), UDim2.fromOffset(112, 104), 10)
C.image(nextLevel, "Crown", "Crown", UDim2.new(0.5, -32, 0, 4), UDim2.fromOffset(64, 64), 11)
local nextLevelText = C.label(nextLevel, "NextLevelText", "Уровень 2", {
	Position = UDim2.fromOffset(0, 66), Size = UDim2.new(1, 0, 0, 24), TextSize = 19, ZIndex = 12,
})
for _, spot in {{10, 8, 18}, {88, 2, 22}} do
	C.image(nextLevel, "Sparkle", "Sparkle", UDim2.fromOffset(spot[1], spot[2]), UDim2.fromOffset(spot[3], spot[3]), 12)
end

---------------------------------------------------------------- data binding
local shownCoins = C.new("NumberValue", gui, {Name = "ShownCoins", Value = 0})
connect(shownCoins:GetPropertyChangedSignal("Value"), function()
	coins.value.Text = Data.format(shownCoins.Value)
end)
local currentFraction = 0
local pendingLevelUp = false
local data

local function setFill(fraction)
	fill.Visible = fraction > 0
	fill.Size = UDim2.fromScale(fraction, 1)
end
local function showProgress()
	local xpValue = math.max(0, data:get("XP"))
	local required = data:get("XPRequired")
	local level = math.max(1, math.floor(data:get("Level")))
	if required > 0 then
		progressText.Text = Data.format(xpValue) .. " / " .. Data.format(required) .. " XP"
		nextLevelText.Text = "Уровень " .. Data.format(level + 1)
	else
		progressText.Text = "МАКС. УРОВЕНЬ"
		nextLevelText.Text = "Максимум"
	end
	local fraction = required > 0 and math.clamp(xpValue / required, 0, 1) or 1
	if fraction == currentFraction and not pendingLevelUp then return end
	if pendingLevelUp then
		-- Finish the old bar, then carry the leftover progress into the new level.
		pendingLevelUp = false
		fill.Visible = true
		Anim.tween(fill, Theme.Time.Fill * 0.6, {Size = UDim2.fromScale(1, 1)}, nil, nil, "fill", function()
			setFill(0)
			fill.Visible = fraction > 0
			Anim.tween(fill, Theme.Time.Fill, {Size = UDim2.fromScale(fraction, 1)}, nil, nil, "fill")
		end)
	else
		fill.Visible = fraction > 0 or currentFraction > 0
		Anim.tween(fill, Theme.Time.Fill, {Size = UDim2.fromScale(fraction, 1)}, nil, nil, "fill", function()
			fill.Visible = fraction > 0
		end)
	end
	currentFraction = fraction
end

data = Data.new(player, function(key, value, old)
	if key == "Coins" then
		if old == nil then
			shownCoins.Value = value
			coins.value.Text = Data.format(value)
		else
			Anim.tween(shownCoins, Theme.Time.Count, {Value = value}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, "count", function()
				coins.value.Text = Data.format(value)
			end)
			if value > old then
				Anim.pop(coins.iconScale, 1.2)
				Anim.flash(coins.shine, "ImageTransparency", 0.1)
			end
		end
	elseif key == "SpeedLevel" then
		speed.value.Text = "Уровень " .. Data.format(math.max(1, value))
		if old ~= nil and value > old then
			Anim.pop(speed.valueScale, 1.3)
			Anim.wiggle(speed.icon, 16)
			Anim.flash(speed.shine, "ImageTransparency", 0.2)
		end
	elseif key == "Level" then
		levelText.Text = Data.format(math.max(1, math.floor(value)))
		if old ~= nil and value > old then
			pendingLevelUp = true
			Anim.pop(badgeScale, 1.22)
			Anim.flash(starFlash, "ImageTransparency", 0)
		end
		showProgress()
	else -- XP / XPRequired
		showProgress()
	end
end)

---------------------------------------------------------------- layout
-- Pixel layout from the safe area: groups keep their reference proportions,
-- scale with the screen and never overlap. Narrow screens stack the counters
-- above the XP panel.
local function layout()
	local area = root.AbsoluteSize
	if area.X < 1 or area.Y < 1 then return end
	local w, h = area.X, area.Y
	local s = math.clamp(math.min(w / S.Reference.X, h / S.Reference.Y), 0.4, 1.3)
	local side = math.max(10, S.Left * s)
	local bottom = math.max(8, S.Bottom * s)
	local stacked = w / 2 - S.XPW * s / 2 < side + COUNTERS_W * s + 16
	local xs = stacked and math.min(s * 1.1, (w - 2 * side) / S.XPW) or s
	xpScale.Scale = xs
	local xpTop = h - S.XPH * xs - bottom
	xp.Position = UDim2.fromOffset(math.floor((w - S.XPW * xs) / 2), math.floor(xpTop))
	counterScale.Scale = s
	local countersBottom = stacked and (xpTop - 6) or (h - bottom)
	local countersTop = countersBottom - COUNTERS_H * s
	counters.Position = UDim2.fromOffset(math.floor(side), math.floor(countersTop))
	local top = math.max(8, S.Top * s)
	local available = countersTop - top - 18
	local ns = math.clamp(math.min(s * 1.05, available / NAV_H), 0.3, 1.3)
	navScale.Scale = ns
	navigation.Position = UDim2.fromOffset(math.floor(side), math.floor(math.max(8, math.min(top, countersTop - 18 - NAV_H * ns))))
	-- Menus shrink to fit small screens (the window's own UIScale is used by the open animation).
	local menuFit = math.min(1, (w - 24) / S.MenuW, (h - 24) / (S.MenuH + 10))
	for _, entry in menus.windows do
		entry.fit.Scale = menuFit
		entry.window.Size = UDim2.fromOffset(S.MenuW * menuFit, (S.MenuH + 10) * menuFit)
	end
end
connect(root:GetPropertyChangedSignal("AbsoluteSize"), layout)
data:start()

connect(gui.Destroying, function()
	data:destroy()
	menus:destroy()
	Anim.cancelAll()
	for _, connection in connections do connection:Disconnect() end
	table.clear(connections)
end)
layout()
]]></string>
    </Properties>
    <Item class="ModuleScript" referent="1">
      <Properties>
        <string name="Name">UITheme</string>
        <string name="Source"><![CDATA[-- UITheme: palette, sizes and timings for the OceanHUD. All sizes are at the
-- 1648x928 reference resolution; the controller scales them for each screen.
local function rgb(r, g, b) return Color3.fromRGB(r, g, b) end

local UITheme = {}

UITheme.Font = Enum.Font.FredokaOne
UITheme.Ink = rgb(26, 16, 48)
UITheme.White = rgb(255, 255, 255)

-- Left column, top to bottom.
UITheme.Buttons = {
	{key = "Rebirth", title = "Перерождение", top = rgb(204, 120, 255), bottom = rgb(116, 38, 214), edge = rgb(72, 18, 150), glow = rgb(236, 190, 255)},
	{key = "Gifts", title = "Подарки", top = rgb(255, 222, 70), bottom = rgb(255, 128, 16), edge = rgb(196, 76, 0), glow = rgb(255, 236, 150)},
	{key = "Shop", title = "Магазин", top = rgb(255, 104, 96), bottom = rgb(206, 20, 40), edge = rgb(140, 8, 24), glow = rgb(255, 180, 170)},
	{key = "Index", title = "Индекс", top = rgb(96, 200, 255), bottom = rgb(24, 98, 234), edge = rgb(12, 56, 170), glow = rgb(170, 230, 255)},
}

UITheme.Coins = {
	top = rgb(112, 68, 24), bottom = rgb(52, 28, 8), rim = rgb(255, 204, 52), glow = rgb(255, 150, 30),
	valueTop = rgb(255, 244, 130), valueBottom = rgb(255, 178, 20),
}
UITheme.Speed = {
	top = rgb(54, 146, 255), bottom = rgb(16, 56, 198), rim = rgb(128, 230, 255), glow = rgb(70, 200, 255),
	valueTop = rgb(255, 248, 130), valueBottom = rgb(255, 196, 30),
}
UITheme.XP = {
	top = rgb(38, 62, 176), bottom = rgb(14, 22, 92), rim = rgb(92, 214, 255), glow = rgb(60, 180, 255),
	track = rgb(8, 14, 50), fillTop = rgb(150, 252, 255), fillBottom = rgb(22, 146, 255),
}

UITheme.Size = {
	Reference = Vector2.new(1648, 928),
	ButtonW = 112, ButtonH = 106, ButtonGap = 12,
	Left = 35, Top = 60, Bottom = 22,
	CounterW = 340, CounterH = 88, CounterGap = 14,
	XPW = 560, XPH = 116,
	MenuW = 560, MenuH = 400,
}

UITheme.Time = {
	Hover = 0.17, Press = 0.08, Release = 0.3,
	MenuOpen = 0.26, MenuClose = 0.16,
	Count = 0.6, Fill = 0.45, Pop = 0.35,
}

return UITheme
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name">UIAssets</string>
        <string name="Source"><![CDATA[-- UIAssets: every image and sound the HUD uses, in one place.
--
-- The PNG icons live in OceanHUD/assets (drawn by tools/draw_icons.py).
-- For a published game: upload them once (Studio > Asset Manager > Bulk Import),
-- then paste each "rbxassetid://..." into Uploaded below. Only real IDs from your
-- own uploads belong here.
-- Until then, Studio can show them from its local content folder
-- (tools/install-studio-textures.ps1 copies them there); that path only works
-- on this computer, not for other players.
local UIAssets = {}

UIAssets.Uploaded = {
	Rebirth = "",
	Gifts = "",
	Shop = "",
	Index = "",
	Coin = "",
	Speed = "",
	LevelStar = "",
	Crown = "",
	Sparkle = "",
	Stripes = "",
}

UIAssets.LocalFolder = "rbxasset://textures/OceanHUD/"

-- Built-in Roblox client sound (ships with every client, no upload needed).
UIAssets.ClickSound = "rbxasset://sounds/volume_slider.ogg"

function UIAssets.image(name: string): string
	local id = UIAssets.Uploaded[name]
	if type(id) == "string" and id ~= "" then
		return id
	end
	return UIAssets.LocalFolder .. name .. ".png"
end

function UIAssets.isUploaded(name: string): boolean
	local id = UIAssets.Uploaded[name]
	return type(id) == "string" and id ~= ""
end

return UIAssets
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="3">
      <Properties>
        <string name="Name">UIComponents</string>
        <string name="Source"><![CDATA[-- UIComponents: reusable building blocks. Volume is faked with stacked layers:
-- outer shadow, darker bottom edge, gradient body, light top highlight and gloss.
local Theme = require(script.Parent.UITheme)
local Assets = require(script.Parent.UIAssets)

local UIComponents = {}

function UIComponents.new(class: string, parent: Instance?, props: {[string]: any}?): any
	local object = Instance.new(class)
	for key, value in pairs(props or {}) do
		object[key] = value
	end
	object.Parent = parent
	return object
end
local new = UIComponents.new

function UIComponents.corner(object: Instance, scale: number?, offset: number?)
	return new("UICorner", object, {CornerRadius = UDim.new(scale or 0, offset or 0)})
end

function UIComponents.stroke(object: Instance, color: Color3, thickness: number, transparency: number?)
	return new("UIStroke", object, {
		Color = color, Thickness = thickness, Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border, LineJoinMode = Enum.LineJoinMode.Round,
	})
end

function UIComponents.gradient(object: Instance, top: Color3, bottom: Color3, rotation: number?)
	return new("UIGradient", object, {Color = ColorSequence.new(top, bottom), Rotation = rotation or 90})
end

function UIComponents.fadeGradient(object: Instance, from: number, to: number, rotation: number?)
	return new("UIGradient", object, {
		Transparency = NumberSequence.new(from, to), Rotation = rotation or 90,
	})
end

function UIComponents.frame(parent: Instance, name: string, props: {[string]: any}?)
	local object = new("Frame", parent, {Name = name, BorderSizePixel = 0, BackgroundColor3 = Theme.White})
	for key, value in pairs(props or {}) do
		object[key] = value
	end
	return object
end

function UIComponents.holder(parent: Instance, name: string, position: UDim2, size: UDim2, z: number?)
	return UIComponents.frame(parent, name, {
		Position = position, Size = size, BackgroundTransparency = 1, ZIndex = z or 1,
	})
end

-- Text with a thick dark outline. A gradient (top -> bottom) is optional; the
-- text colour is white then, because UIGradient multiplies it.
function UIComponents.label(parent: Instance, name: string, text: string, props: {[string]: any}?, outline: Color3?, gradientColors: {Color3}?)
	local object = new("TextLabel", parent, {
		Name = name, Text = text, BackgroundTransparency = 1, BorderSizePixel = 0,
		Font = Theme.Font, TextColor3 = Theme.White, TextSize = 20, ZIndex = 5,
	})
	for key, value in pairs(props or {}) do
		object[key] = value
	end
	new("UIStroke", object, {
		Color = outline or Theme.Ink, Thickness = math.clamp(object.TextSize / 10, 1.5, 3.5),
		LineJoinMode = Enum.LineJoinMode.Round,
	})
	if gradientColors then
		object.TextColor3 = Theme.White
		UIComponents.gradient(object, gradientColors[1], gradientColors[2])
	end
	return object
end

function UIComponents.image(parent: Instance, name: string, assetName: string, position: UDim2, size: UDim2, z: number?)
	return new("ImageLabel", parent, {
		Name = name, Image = Assets.image(assetName), Position = position, Size = size,
		BackgroundTransparency = 1, BorderSizePixel = 0, ScaleType = Enum.ScaleType.Fit, ZIndex = z or 4,
	})
end

-- Volumetric rounded plate. Returns the body frame (put content inside the
-- returned holder, which is a sibling-safe container of the same size).
-- style = {top, bottom, edge?, rim, rimThickness?, glow?, radius (scale)}
function UIComponents.plate(parent: Instance, name: string, position: UDim2, size: UDim2, style, z: number?)
	z = z or 1
	local holder = UIComponents.holder(parent, name, position, size, z)
	local radius = UDim.new(style.radius or 0.5, 0)
	local glow
	if style.glow then
		glow = UIComponents.frame(holder, "Glow", {
			AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(1, 14, 1, 14), BackgroundColor3 = style.glow,
			BackgroundTransparency = style.glowTransparency or 0.62, ZIndex = z,
		})
		new("UICorner", glow, {CornerRadius = radius})
	end
	local shadow = UIComponents.frame(holder, "Shadow", {
		Position = UDim2.fromOffset(0, 7), Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Ink, BackgroundTransparency = 0.45, ZIndex = z,
	})
	new("UICorner", shadow, {CornerRadius = radius})
	local edge = UIComponents.frame(holder, "Edge", {
		Position = UDim2.fromOffset(0, 4), Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = style.edge or style.bottom:Lerp(Theme.Ink, 0.45), ZIndex = z,
	})
	new("UICorner", edge, {CornerRadius = radius})
	local body = UIComponents.frame(holder, "Body", {Size = UDim2.fromScale(1, 1), ZIndex = z + 1})
	new("UICorner", body, {CornerRadius = radius})
	UIComponents.gradient(body, style.top, style.bottom)
	local rim = UIComponents.stroke(body, style.rim, style.rimThickness or 3)
	-- Light upper half: a white sheet that fades out towards the middle.
	local sheen = UIComponents.frame(body, "Sheen", {
		Position = UDim2.fromOffset(4, 3), Size = UDim2.new(1, -8, 0.5, 0),
		BackgroundTransparency = 0.55, ZIndex = z + 2,
	})
	new("UICorner", sheen, {CornerRadius = radius})
	UIComponents.fadeGradient(sheen, 0.25, 1)
	return holder, body, rim, glow
end

return UIComponents
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">UIAnimations</string>
        <string name="Source"><![CDATA[-- UIAnimations: TweenService helpers. Event-driven only (no per-frame loops),
-- and every running tween for an object/property group can be cancelled.
local TweenService = game:GetService("TweenService")
local Theme = require(script.Parent.UITheme)

local UIAnimations = {}

local running = setmetatable({}, {__mode = "k"})

-- Plays a tween, cancelling the previous one on the same object + channel.
function UIAnimations.tween(object: Instance, duration: number, props: {[string]: any}, style: Enum.EasingStyle?, direction: Enum.EasingDirection?, channel: string?, onDone: (() -> ())?)
	channel = channel or "default"
	running[object] = running[object] or {}
	local previous = running[object][channel]
	if previous then
		previous:Cancel()
	end
	local info = TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out)
	local t = TweenService:Create(object, info, props)
	running[object][channel] = t
	local connection
	connection = t.Completed:Connect(function(state)
		connection:Disconnect()
		if running[object] and running[object][channel] == t then
			running[object][channel] = nil
		end
		if onDone and state == Enum.PlaybackState.Completed then
			onDone()
		end
	end)
	t:Play()
	return t
end

function UIAnimations.cancelAll()
	for _, channels in pairs(running) do
		for _, t in pairs(channels) do
			t:Cancel()
		end
	end
	table.clear(running)
end

-- Quick grow then elastic return. scaleObject is a UIScale.
function UIAnimations.pop(scaleObject: UIScale, peak: number?, duration: number?)
	scaleObject.Scale = peak or 1.25
	return UIAnimations.tween(scaleObject, duration or Theme.Time.Pop, {Scale = 1}, Enum.EasingStyle.Back, Enum.EasingDirection.Out, "pop")
end

-- Brief flash: object becomes visible at `from` transparency and fades out.
function UIAnimations.flash(object: GuiObject, property: string, from: number, duration: number?)
	object[property] = from
	return UIAnimations.tween(object, duration or 0.45, {[property] = 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, "flash")
end

-- Little wiggle (rotation), e.g. for the lightning bolt.
function UIAnimations.wiggle(object: GuiObject, angle: number?)
	object.Rotation = angle or 14
	return UIAnimations.tween(object, 0.45, {Rotation = 0}, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out, "wiggle")
end

-- Hover / press behaviour for a candy button. Returns its connections.
-- parts = {button, scale (UIScale), rim (UIStroke), glow (Frame), sound (Sound?)}
function UIAnimations.bindButton(parts, onActivated: () -> ())
	local button, scale, rim, glow, sound = parts.button, parts.scale, parts.rim, parts.glow, parts.sound
	local hovered = false
	local function hover(on: boolean)
		hovered = on
		UIAnimations.tween(scale, Theme.Time.Hover, {Scale = on and 1.07 or 1}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, "hover")
		UIAnimations.tween(rim, Theme.Time.Hover, {Transparency = on and 0 or 0.25}, nil, nil, "rim")
		UIAnimations.tween(glow, Theme.Time.Hover, {BackgroundTransparency = on and 0.45 or 1}, nil, nil, "glow")
	end
	local connections = {
		button.MouseEnter:Connect(function() hover(true) end),
		button.MouseLeave:Connect(function() hover(false) end),
		button.SelectionGained:Connect(function() hover(true) end),
		button.SelectionLost:Connect(function() hover(false) end),
		button.Activated:Connect(function()
			if sound then
				sound:Play()
			end
			UIAnimations.tween(scale, Theme.Time.Press, {Scale = 0.93}, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, "hover", function()
				UIAnimations.tween(scale, Theme.Time.Release, {Scale = hovered and 1.07 or 1}, Enum.EasingStyle.Back, Enum.EasingDirection.Out, "hover")
			end)
			onActivated()
		end),
	}
	return connections
end

return UIAnimations
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="5">
      <Properties>
        <string name="Name">UIDataController</string>
        <string name="Source"><![CDATA[-- UIDataController: reads the player's stats and reports changes.
-- The server is the source of truth: it writes player attributes (see
-- OceanHUDStats on the server) or leaderstats values; the client only reads.
local UIDataController = {}
UIDataController.__index = UIDataController

-- Attributes win over same-named leaderstats values; the first name found wins.
UIDataController.Aliases = {
	Coins = {"Coins", "Money", "Cash", "Монеты", "Деньги"},
	SpeedLevel = {"SpeedLevel", "Speed", "Скорость"},
	Level = {"Level", "Уровень"},
	XP = {"XP", "Experience", "LevelProgress"},
	XPRequired = {"XPRequired", "XPToNextLevel", "RequiredXP", "NextLevelXP"},
}
UIDataController.Defaults = {Coins = 0, SpeedLevel = 1, Level = 1, XP = 0, XPRequired = 10000}

local function finite(value)
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

-- onChange(key, newValue, oldValue) fires once per real change.
function UIDataController.new(player: Player, onChange: (string, number, number?) -> ())
	local self = setmetatable({
		player = player, onChange = onChange, values = {}, connections = {}, statConnections = {}, alive = true,
	}, UIDataController)
	for _, names in pairs(UIDataController.Aliases) do
		for _, name in names do
			table.insert(self.connections, player:GetAttributeChangedSignal(name):Connect(function() self:refresh() end))
		end
	end
	table.insert(self.connections, player.ChildAdded:Connect(function(child)
		if child.Name == "leaderstats" then self:bindStats() end
	end))
	table.insert(self.connections, player.ChildRemoved:Connect(function(child)
		if child.Name == "leaderstats" then self:bindStats() end
	end))
	return self
end

-- Call after storing the controller: reads current values and fires onChange for each.
function UIDataController:start()
	self:bindStats()
end

function UIDataController:read(key: string): number
	local names = UIDataController.Aliases[key]
	for _, name in names do
		local value = self.player:GetAttribute(name)
		if finite(value) then return value end
	end
	local stats = self.player:FindFirstChild("leaderstats")
	if stats then
		for _, name in names do
			local object = stats:FindFirstChild(name)
			if object and (object:IsA("IntValue") or object:IsA("NumberValue")) and finite(object.Value) then
				return object.Value
			end
		end
	end
	return UIDataController.Defaults[key]
end

function UIDataController:get(key: string): number
	return self.values[key] or self:read(key)
end

function UIDataController:refresh()
	if not self.alive then return end
	-- Level first, so XP handlers already see the new level.
	for _, key in {"Level", "XPRequired", "XP", "Coins", "SpeedLevel"} do
		local value = self:read(key)
		local old = self.values[key]
		if value ~= old then
			self.values[key] = value
			self.onChange(key, value, old)
		end
	end
end

function UIDataController:clearStats()
	for _, connection in self.statConnections do connection:Disconnect() end
	table.clear(self.statConnections)
end

function UIDataController:bindStats()
	self:clearStats()
	local stats = self.player:FindFirstChild("leaderstats")
	if stats then
		local function changed() self:bindStats() end
		table.insert(self.statConnections, stats.ChildAdded:Connect(changed))
		table.insert(self.statConnections, stats.ChildRemoved:Connect(changed))
		for _, object in stats:GetChildren() do
			if object:IsA("IntValue") or object:IsA("NumberValue") then
				table.insert(self.statConnections, object:GetPropertyChangedSignal("Value"):Connect(function() self:refresh() end))
			end
		end
	end
	self:refresh()
end

function UIDataController:destroy()
	self.alive = false
	self:clearStats()
	for _, connection in self.connections do connection:Disconnect() end
	table.clear(self.connections)
end

-- 125430 -> "125,430"; huge values are shortened (2.5B) to keep plates tidy.
function UIDataController.format(value: number): string
	value = math.max(0, math.floor(value + 0.5))
	for _, unit in {{1e15, "Qa"}, {1e12, "T"}, {1e9, "B"}} do
		if value >= unit[1] then
			return (string.gsub(string.format("%.1f", value / unit[1]), "%.0$", "")) .. unit[2]
		end
	end
	local text = string.format("%d", value)
	local result = text:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (result:gsub("^,", ""))
end

return UIDataController
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="6">
      <Properties>
        <string name="Name">MenuController</string>
        <string name="Source"><![CDATA[-- MenuController: one main window at a time, Scale + Fade open/close,
-- close button, backdrop click, Escape, and toggling by pressing the same button.
-- Each window has an empty "Content" ScrollingFrame for the future game content.
local UserInputService = game:GetService("UserInputService")
local Theme = require(script.Parent.UITheme)
local C = require(script.Parent.UIComponents)
local Anim = require(script.Parent.UIAnimations)

local MenuController = {}
MenuController.__index = MenuController

local DESCRIPTIONS = {
	Rebirth = "Начни заново и получи постоянный бонус к доходу и скорости.",
	Gifts = "Забирай подарки за время в игре и ежедневные награды.",
	Shop = "Улучшения скорости, яйца и полезные предметы.",
	Index = "Коллекция всех найденных яиц и питомцев.",
}

function MenuController.new(root: GuiObject, openEvent: BindableEvent, sound: Sound?)
	local self = setmetatable({root = root, openEvent = openEvent, sound = sound, windows = {}, current = nil, connections = {}}, MenuController)
	local size = Theme.Size
	local backdrop = C.new("TextButton", root, {
		Name = "MenuBackdrop", Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Theme.Ink, BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, ZIndex = 30,
	})
	self.backdrop = backdrop
	for _, spec in Theme.Buttons do
		local window = C.new("CanvasGroup", backdrop, {
			Name = spec.key .. "Menu", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(size.MenuW, size.MenuH + 10), BackgroundTransparency = 1,
			GroupTransparency = 1, Visible = false, ZIndex = 31,
		})
		local scale = C.new("UIScale", window, {Scale = 0.85})
		local panel, body = C.plate(window, "Panel", UDim2.fromOffset(0, 0), UDim2.fromOffset(size.MenuW, size.MenuH), {
			top = spec.top, bottom = spec.bottom, edge = spec.edge, rim = Theme.Ink, rimThickness = 4, radius = 0.08,
		}, 31)
		local fit = C.new("UIScale", panel, {Name = "Fit", Scale = 1})
		local inner = C.holder(body, "InnerRim", UDim2.fromOffset(7, 7), UDim2.new(1, -14, 1, -14), 34)
		C.corner(inner, 0.07)
		C.stroke(inner, Theme.White, 3, 0.3)
		C.image(body, "Icon", spec.key, UDim2.fromOffset(18, 10), UDim2.fromOffset(78, 78), 35)
		local title = C.label(body, "Title", spec.title, {
			Position = UDim2.fromOffset(104, 18), Size = UDim2.fromOffset(360, 56), TextSize = 40,
			TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 35,
		})
		title.TextScaled = false
		local close = C.new("TextButton", body, {
			Name = "Close", Text = "X", Font = Theme.Font, TextSize = 30, TextColor3 = Theme.White,
			AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16), Size = UDim2.fromOffset(52, 52),
			BackgroundColor3 = Theme.White, AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 36,
		})
		C.corner(close, 0.3)
		C.gradient(close, Color3.fromRGB(255, 104, 96), Color3.fromRGB(206, 20, 40))
		C.stroke(close, Theme.Ink, 3.5)
		C.new("UIStroke", close, {Color = Theme.Ink, Thickness = 2.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual})
		local closeScale = C.new("UIScale", close, {Scale = 1})
		-- Content area for the real menu items later.
		local content = C.new("ScrollingFrame", body, {
			Name = "Content", Position = UDim2.fromOffset(22, 96), Size = UDim2.new(1, -44, 1, -118),
			BackgroundColor3 = Theme.Ink, BackgroundTransparency = 0.72, BorderSizePixel = 0,
			ScrollBarThickness = 8, CanvasSize = UDim2.fromScale(0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 35,
		})
		C.corner(content, 0, 18)
		C.new("UIPadding", content, {
			PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14), PaddingLeft = UDim.new(0, 16), PaddingRight = UDim.new(0, 16),
		})
		C.new("UIListLayout", content, {Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder})
		local placeholder = C.label(content, "Placeholder", DESCRIPTIONS[spec.key], {
			Size = UDim2.new(1, 0, 0, 90), TextSize = 24, TextWrapped = true, ZIndex = 36,
		})
		placeholder.LayoutOrder = 1
		table.insert(self.connections, close.MouseEnter:Connect(function()
			Anim.tween(closeScale, Theme.Time.Hover, {Scale = 1.1}, nil, nil, "hover")
		end))
		table.insert(self.connections, close.MouseLeave:Connect(function()
			Anim.tween(closeScale, Theme.Time.Hover, {Scale = 1}, nil, nil, "hover")
		end))
		table.insert(self.connections, close.Activated:Connect(function()
			if self.sound then self.sound:Play() end
			self:close()
		end))
		-- Clicks on the window itself must not fall through to the backdrop.
		window.Active = true
		self.windows[spec.key] = {window = window, scale = scale, fit = fit, content = content}
	end
	table.insert(self.connections, backdrop.Activated:Connect(function() self:close() end))
	table.insert(self.connections, UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.Escape then self:close() end
	end))
	return self
end

function MenuController:open(key: string)
	local entry = self.windows[key]
	if not entry then return end
	if self.current and self.current ~= key then
		self:hide(self.current, true)
	end
	self.current = key
	self.backdrop.Visible = true
	Anim.tween(self.backdrop, Theme.Time.MenuOpen, {BackgroundTransparency = 0.45}, nil, nil, "fade")
	entry.window.Visible = true
	entry.window.GroupTransparency = 1
	entry.scale.Scale = 0.85
	Anim.tween(entry.window, Theme.Time.MenuOpen, {GroupTransparency = 0}, nil, nil, "fade")
	Anim.tween(entry.scale, Theme.Time.MenuOpen, {Scale = 1}, Enum.EasingStyle.Back, Enum.EasingDirection.Out, "scale")
	self.openEvent:Fire(key)
end

function MenuController:hide(key: string, instant: boolean?)
	local entry = self.windows[key]
	if not entry then return end
	if instant then
		entry.window.Visible = false
		entry.window.GroupTransparency = 1
		return
	end
	Anim.tween(entry.scale, Theme.Time.MenuClose, {Scale = 0.88}, nil, nil, "scale")
	Anim.tween(entry.window, Theme.Time.MenuClose, {GroupTransparency = 1}, nil, nil, "fade", function()
		if self.current ~= key then entry.window.Visible = false end
	end)
end

function MenuController:close()
	local key = self.current
	if not key then return end
	self.current = nil
	self:hide(key)
	Anim.tween(self.backdrop, Theme.Time.MenuClose, {BackgroundTransparency = 1}, nil, nil, "fade", function()
		if not self.current then self.backdrop.Visible = false end
	end)
end

function MenuController:toggle(key: string)
	if self.current == key then
		self:close()
	else
		self:open(key)
	end
end

function MenuController:getContent(key: string): ScrollingFrame?
	local entry = self.windows[key]
	return entry and entry.content
end

function MenuController:destroy()
	for _, connection in self.connections do connection:Disconnect() end
	table.clear(self.connections)
end

return MenuController
]]></string>
      </Properties>
    </Item>
  </Item>
</roblox>