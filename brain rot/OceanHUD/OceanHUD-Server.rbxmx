<roblox version="4">
  <Item class="ModuleScript" referent="0">
    <Properties>
      <string name="Name">OceanHUDStats</string>
      <string name="Source"><![CDATA[-- OceanHUDStats (ModuleScript, ServerScriptService): the server-side source of
-- truth for the values the HUD shows. Only server code should call these; the
-- client HUD just reads the player attributes they write.
--
--   local Stats = require(game.ServerScriptService.OceanHUDStats)
--   Stats.addCoins(player, 250)
--   Stats.addSpeed(player, 1)      -- one more upgrade bought
local OceanHUDStats = {}

OceanHUDStats.Defaults = {Coins = 0, SpeedLevel = 0}

local function number(player: Player, name: string): number
	local value = player:GetAttribute(name)
	if type(value) == "number" and value == value then return value end
	return OceanHUDStats.Defaults[name] or 0
end

function OceanHUDStats.init(player: Player, saved: {[string]: number}?)
	saved = saved or {}
	for name, default in OceanHUDStats.Defaults do
		local value = saved[name]
		player:SetAttribute(name, if type(value) == "number" then value else default)
	end
end

function OceanHUDStats.setCoins(player: Player, amount: number)
	player:SetAttribute("Coins", math.max(0, math.floor(amount)))
end

function OceanHUDStats.addCoins(player: Player, amount: number)
	OceanHUDStats.setCoins(player, number(player, "Coins") + amount)
end

-- Upgraded speed amount (shown as a plain number in the HUD).
function OceanHUDStats.setSpeed(player: Player, amount: number)
	player:SetAttribute("SpeedLevel", math.max(0, math.floor(amount)))
end

function OceanHUDStats.addSpeed(player: Player, amount: number)
	OceanHUDStats.setSpeed(player, number(player, "SpeedLevel") + amount)
end

return OceanHUDStats
]]></string>
    </Properties>
  </Item>
  <Item class="ModuleScript" referent="1">
    <Properties>
      <string name="Name">OceanInventory</string>
      <string name="Source"><![CDATA[-- OceanInventory (ModuleScript, ServerScriptService): server-owned inventory.
-- Items live in Player.Inventory (replicated to that player's client), one
-- Folder per item with attributes the HUD reads:
--   DisplayName, Category ("Eggs" | "Fish"), Icon, Count, HotbarSlot (1-8, optional)
--
--   local Inventory = require(game.ServerScriptService.OceanInventory)
--   Inventory.add(player, "BasicEgg", {Name = "Обычное яйцо", Category = "Eggs", Icon = "Egg"})
--   Inventory.remove(player, "BasicEgg", 1)
--   Inventory.setHotbar(player, "BasicEgg", 1)
local OceanInventory = {}

OceanInventory.Categories = {Eggs = true, Fish = true}
OceanInventory.HotbarSlots = 8

function OceanInventory.folder(player: Player): Folder
	local folder = player:FindFirstChild("Inventory")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Inventory"
		folder.Parent = player
	end
	return folder
end

-- info = {Name: string, Category: string, Icon: string?, Count: number?, Data: {[string]: any}?}
function OceanInventory.add(player: Player, id: string, info)
	assert(type(id) == "string" and id ~= "", "Item id required")
	assert(OceanInventory.Categories[info.Category], "Unknown category: " .. tostring(info.Category))
	local amount = math.max(1, math.floor(info.Count or 1))
	local folder = OceanInventory.folder(player)
	local item = folder:FindFirstChild(id)
	if item then
		item:SetAttribute("Count", (item:GetAttribute("Count") or 0) + amount)
		return item
	end
	item = Instance.new("Folder")
	item.Name = id
	item:SetAttribute("DisplayName", info.Name or id)
	item:SetAttribute("Category", info.Category)
	item:SetAttribute("Icon", info.Icon or "")
	item:SetAttribute("Count", amount)
	for key, value in pairs(info.Data or {}) do item:SetAttribute(key, value) end
	item.Parent = folder
	return item
end

-- Removes `count` (default: all). Returns true if the player had enough.
function OceanInventory.remove(player: Player, id: string, count: number?): boolean
	local item = OceanInventory.folder(player):FindFirstChild(id)
	if not item then return false end
	local have = item:GetAttribute("Count") or 0
	local take = count and math.floor(count) or have
	if take > have then return false end
	if have - take <= 0 then
		item:Destroy()
	else
		item:SetAttribute("Count", have - take)
	end
	return true
end

function OceanInventory.count(player: Player, id: string): number
	local item = OceanInventory.folder(player):FindFirstChild(id)
	return item and (item:GetAttribute("Count") or 0) or 0
end

-- Puts an item into hotbar slot 1-8 (nil clears it); one item per slot.
function OceanInventory.setHotbar(player: Player, id: string, slot: number?)
	local folder = OceanInventory.folder(player)
	local item = folder:FindFirstChild(id)
	if not item then return end
	if slot ~= nil then
		slot = math.floor(slot)
		assert(slot >= 1 and slot <= OceanInventory.HotbarSlots, "Hotbar slot must be 1-8")
		for _, other in folder:GetChildren() do
			if other ~= item and other:GetAttribute("HotbarSlot") == slot then
				other:SetAttribute("HotbarSlot", nil)
			end
		end
	end
	item:SetAttribute("HotbarSlot", slot)
end

return OceanInventory
]]></string>
    </Properties>
  </Item>
  <Item class="Script" referent="2">
    <Properties>
      <string name="Name">OceanHUDTestData</string>
      <string name="Source"><![CDATA[-- OceanHUDTestData (Script, ServerScriptService): Studio-only starting values
-- for checking the HUD. Does nothing on live servers.
-- In Studio, while playing, run in the Command Bar (Server) to see animations:
--   local S = require(game.ServerScriptService.OceanHUDStats)
--   local I = require(game.ServerScriptService.OceanInventory)
--   local p = game.Players:GetPlayers()[1]
--   S.addCoins(p, 5000)  S.addSpeed(p, 1)
--   I.add(p, "TideEgg", {Name = "Яйцо прилива", Category = "Eggs", Icon = "Egg"})
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
if not RunService:IsStudio() then return end

local Stats = require(script.Parent:WaitForChild("OceanHUDStats"))
local Inventory = require(script.Parent:WaitForChild("OceanInventory"))

local function seed(player: Player)
	if player:GetAttribute("Coins") ~= nil then return end
	Stats.init(player, {Coins = 125430, SpeedLevel = 18})
	-- Sample eggs of several sections and one fish, to try the pen and its menus.
	Inventory.add(player, "TideEgg", {Name = "Яйцо прилива", Category = "Eggs", Icon = "Egg", Count = 3})
	Inventory.add(player, "CoralEgg", {Name = "Коралловое яйцо", Category = "Eggs", Icon = "Egg", Count = 2})
	Inventory.add(player, "GlacierEgg", {Name = "Ледниковое яйцо", Category = "Eggs", Icon = "Egg"})
	Inventory.add(player, "OceanCrownEgg", {Name = "Яйцо Короны океана", Category = "Eggs", Icon = "Egg"})
	Inventory.add(player, "Fish_Clown_L3", {Name = "Рыба-клоун · ур. 3", Category = "Fish", Icon = "SharkFin",
		Data = {FishType = "Clown", Level = 3}})
	Inventory.setHotbar(player, "TideEgg", 1)
	Inventory.setHotbar(player, "Fish_Clown_L3", 2)
end
Players.PlayerAdded:Connect(seed)
for _, player in Players:GetPlayers() do seed(player) end
]]></string>
    </Properties>
  </Item>
</roblox>