local sin, cos, rad = math.sin, math.cos, math.rad
local tau = 2 * math.pi
local active, pending = {}, {}

local function readNumber(mesh, name, fallback, minimum, maximum)
	local current = mesh
	while current and current ~= Workspace do
		local value = current:GetAttribute(name)
		if typeof(value) == "number" and value == value then
			return math.clamp(value, minimum, maximum)
		end
		current = current.Parent
	end
	return fallback
end

local function makeEmitter(anchor, style, scale)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = style.name
	emitter.Enabled = false
	emitter.Texture = textures[style.texture]
	emitter.EmissionDirection = if style.rear then Enum.NormalId.Back
		elseif style.anchor == "Mouth" then Enum.NormalId.Front else Enum.NormalId.Top
	emitter.LockedToPart = false
	emitter.LightInfluence = 0
	emitter.LightEmission = if style.texture == "dust" then 0.14 else 0.68
	emitter.Drag = 0.8
	emitter.Color = ColorSequence.new(style.a, style.b)
	emitter.Rate = style.rate
	emitter.Speed = NumberRange.new(style.speed[1] * scale, style.speed[2] * scale)
	emitter.Lifetime = NumberRange.new(style.life[1], style.life[2])
	local spread = style.spread or 40
	emitter.SpreadAngle = Vector2.new(spread, spread)
	local size = style.size * scale
	local streak = style.texture == "streak" or style.texture == "bolt"
	if streak then
		emitter.Orientation = Enum.ParticleOrientation.VelocityParallel
		emitter.Squash = NumberSequence.new(if style.texture == "bolt" then 0.85 else 1.35)
	else
		emitter.Rotation = NumberRange.new(-180, 180)
		emitter.RotSpeed = NumberRange.new(-75, 75)
	end
	if style.texture == "ring" or style.texture == "dust" then
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, size * 0.38),
			NumberSequenceKeypoint.new(1, size * 1.42),
		})
	else
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, size),
			NumberSequenceKeypoint.new(1, size * 0.24),
		})
	end
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.66),
		NumberSequenceKeypoint.new(0.13, if style.texture == "dust" then 0.42 else 0.13),
		NumberSequenceKeypoint.new(0.56, 0.32),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Parent = anchor
	return emitter
end

local function register(root)
	local config = species[root.Name]
	local mesh = root:FindFirstAncestorWhichIsA("MeshPart")
	if not config or not mesh or active[root] or not root:IsDescendantOf(Workspace) then
		return
	end
	local bones = {[root.Name] = root}
	for _, name in config.joints do
		local bone = root:FindFirstChild(name, true)
		if not bone or not bone:IsA("Bone") then
			return
		end
		bones[name] = bone
	end

	local center = root.WorldPosition
	local axis = center - bones.PredSpine.WorldPosition
	if axis.Magnitude < 0.01 then
		return
	end
	local scale = math.clamp(axis.Magnitude / config.measureDistance, 0.08, 16)
	local particleScale = math.clamp(scale, 0.35, 3.5)
	local forward = axis.Unit
	local flat = Vector3.new(forward.X, 0, forward.Z)
	if flat.Magnitude < 0.01 then
		flat = Vector3.zAxis
	end
	local side = flat.Unit:Cross(Vector3.yAxis)
	local up = side:Cross(forward)
	local basis = CFrame.lookAlong(center, flat.Unit)
	local rest = mesh:GetPivot()

	local anchors = {}
	for name, source in config.anchors do
		local bone = bones[source.bone]
		local offset = source.offset
		local delta = (forward * offset[1] + up * offset[2] + side * offset[3]) * scale
		local attachment = Instance.new("Attachment")
		attachment.Name = "StudPredator_" .. name
		attachment.Parent = mesh
		anchors[name] = {
			part = attachment,
			bone = bone,
			localOffset = bone.WorldCFrame:VectorToObjectSpace(delta),
		}
	end

	local emitters, lights = {}, {}
	for _, style in config.effects do
		table.insert(emitters, {object = makeEmitter(anchors[style.anchor].part, style, particleScale), style = style})
	end
	for _, style in config.lights do
		local object = Instance.new("PointLight")
		object.Name = "PredatorGlow"
		object.Color = style.color
		object.Range = math.clamp(style.range * particleScale, 2, 45)
		object.Enabled = false
		object.Parent = anchors[style.anchor].part
		table.insert(lights, {object = object, style = style})
	end

	local route = config.patrol
	local length = readNumber(mesh, "PatrolRadius", route.length * math.min(scale, 2), 0, 300)
	local width = length * route.width / route.length
	active[root] = {
		mesh = mesh, bones = bones, config = config, scale = scale,
		basis = basis, rest = rest, meshFromBasis = basis:ToObjectSpace(rest),
		up = root.WorldCFrame:VectorToObjectSpace(up),
		length = length, width = width,
		depth = readNumber(mesh, "PatrolDepth", route.depth * math.min(scale, 2), 0, 100),
		speed = readNumber(mesh, "PatrolSpeed", 1, 0.15, 4),
		phase = (center.X * 0.037 + center.Z * 0.023 + center.Y * 0.019) % 1,
		anchors = anchors, emitters = emitters, lights = lights, visible = false,
	}
end

local function consider(instance)
	local candidate = instance
	while candidate and candidate:IsA("Bone") do
		if species[candidate.Name] then
			local root = candidate
			if not active[root] and not pending[root] then
				pending[root] = true
				task.defer(function()
					pending[root] = nil
					register(root)
				end)
			end
			return
		end
		candidate = candidate.Parent
	end
end

local function setVisible(rig, visible)
	rig.visible = visible
	rig.snapEvent, rig.surgeEvent = nil, nil
	for _, emitter in rig.emitters do
		emitter.object.Enabled = visible and emitter.style.rate > 0
		if not visible then
			emitter.object:Clear()
		end
	end
	for _, light in rig.lights do
		light.object.Enabled = visible
	end
end

local function patrol(rig, time)
	local route = rig.config.patrol
	local cycle = time * rig.speed / route.seconds + rig.phase
	local surgeEvent = math.floor(cycle * 2 + 0.12)
	if rig.length == 0 then
		return rig.rest, rig.basis.Position, rig.basis.LookVector, surgeEvent
	end
	local t = (cycle % 1) * tau
	local sway = 2 * t
	local a = t + route.surge * sin(sway)
	local d = 1 + 2 * route.surge * cos(sway)
	local wave = sin(a + 0.45) + route.weave * 0.48 * sin(2 * a - 0.7)
	local slope = cos(a + 0.45) + route.weave * 0.96 * cos(2 * a - 0.7)
	local lateral = sin(a) + route.weave * 0.25 * sin(3 * a - 0.35)
	local lateralSlope = cos(a) + route.weave * 0.75 * cos(3 * a - 0.35)
	local pos = Vector3.new(rig.width * lateral, rig.depth * wave, -rig.length * cos(a))
	local tangent = Vector3.new(rig.width * lateralSlope * d, rig.depth * slope * d, rig.length * sin(a) * d)
	local location = rig.basis:PointToWorldSpace(pos)
	local direction = rig.basis:VectorToWorldSpace(tangent.Unit)
	local bank = rad(route.bank) * (0.55 + 0.45 * cos(2 * a))
	local facing = CFrame.lookAlong(location, direction) * CFrame.Angles(0, 0, bank)
	return facing * rig.meshFromBasis, location, direction, surgeEvent
end

local function animate(root, rig, time, heading, surgeEvent)
	local config = rig.config
	local t = ((time / config.period + rig.phase) % 1) * tau
	local jawCycle = time / config.snap.seconds + rig.phase + config.snap.phase
	local jawPhase = jawCycle % 1
	local open = math.max(0, 1 - math.abs(jawPhase - 0.16) / 0.16) ^ 1.55
	local flash = math.max(0, 1 - math.abs(jawPhase - 0.31) / 0.085)
	local snapEvent = math.floor(jawCycle + 0.69)

	for name, waves in config.tracks do
		local x, y, z = 0, 0, 0
		for _, wave in waves do
			local amount = sin(wave[4] * t + wave[5])
			x += wave[1] * amount
			y += wave[2] * amount
			z += wave[3] * amount
		end
		if name == "PredJaw" then
			z -= config.snap.angle * open
		end
		local transform = CFrame.Angles(rad(x), rad(y), rad(z))
		if name == root.Name then
			local bob = config.bob * rig.scale * (0.5 - 0.5 * cos(t))
			transform = CFrame.new(rig.up * bob) * transform
		end
		rig.bones[name].Transform = transform
	end

	for _, anchor in rig.anchors do
		local location = anchor.bone.TransformedWorldCFrame:PointToWorldSpace(anchor.localOffset)
		anchor.part.WorldCFrame = CFrame.lookAlong(location, heading)
	end
	for _, light in rig.lights do
		local style = light.style
		light.object.Brightness = style.base + style.pulse * (0.42 * sin(2 * t) + flash)
	end
	local snap = rig.snapEvent ~= nil and snapEvent ~= rig.snapEvent
	local surge = rig.length > 0 and rig.surgeEvent ~= nil and surgeEvent ~= rig.surgeEvent
	for _, emitter in rig.emitters do
		local style = emitter.style
		if style.burst and ((style.event == "snap" and snap) or (style.event == "surge" and surge)) then
			emitter.object:Emit(style.burst)
		end
	end
	rig.snapEvent, rig.surgeEvent = snapEvent, surgeEvent
end

Workspace.DescendantAdded:Connect(consider)
for _, instance in Workspace:GetDescendants() do
	consider(instance)
end

RunService.PreRender:Connect(function()
	local camera = Workspace.CurrentCamera
	local time = Workspace:GetServerTimeNow()
	for root, rig in active do
		if not root:IsDescendantOf(Workspace) or not root:IsDescendantOf(rig.mesh) then
			for _, anchor in rig.anchors do
				anchor.part:Destroy()
			end
			active[root] = nil
			consider(root)
			continue
		end

		local pivot, location, heading, surgeEvent = patrol(rig, time)
		local visible = camera ~= nil and (camera.CFrame.Position - location).Magnitude < 215 * math.max(1, math.min(rig.scale, 2))
		if visible ~= rig.visible then
			setVisible(rig, visible)
		end
		if visible then
			if rig.length > 0 then
				rig.mesh:PivotTo(pivot)
			end
			animate(root, rig, time, heading, surgeEvent)
		end
	end
end)


]]></ProtectedString>
    </Properties>
  </Item>
</roblox>