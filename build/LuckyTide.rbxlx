  <Item class="ServerScriptService" referent="1833">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="1834">
      <Properties>
        <string name="Name">LuckyTide</string>
      </Properties>
      <Item class="ModuleScript" referent="1835">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[local ServerStorage = game:GetService("ServerStorage")
local Lighting = game:GetService("Lighting")
local V = require(script.Parent.Visuals)
local World = {}
local rgb = Color3.fromRGB

local function tree(parent, x, z, scale)
	local trunk = V.part(parent, "PalmTrunk", Vector3.new(1.3, 10, 1.3) * scale,
		CFrame.new(x, 5 * scale, z) * CFrame.Angles(0, 0, 0.12), rgb(155, 104, 65), Enum.Material.Wood)
	for i = 1, 5 do
		V.part(parent, "PalmLeaf", Vector3.new(2.5, 0.6, 9) * scale,
			CFrame.new(x + 0.6, 10 * scale, z) * CFrame.Angles(0, i * math.pi * 2 / 5, 0) * CFrame.new(0, 0, -3 * scale) * CFrame.Angles(-0.22, 0, 0), rgb(52, 164, 108))
	end
	trunk.CanCollide = false
end

function World.Build()
	local existing = workspace:FindFirstChild("LuckyTideWorld")
	if existing then existing:Destroy() end
	local root = Instance.new("Folder"); root.Name = "LuckyTideWorld"; root.Parent = workspace
	local decor = Instance.new("Folder"); decor.Name = "Scenery"; decor.Parent = root
	local plots = Instance.new("Folder"); plots.Name = "Plots"; plots.Parent = root
	local blocks = Instance.new("Folder"); blocks.Name = "Blocks"; blocks.Parent = root
	local drops = Instance.new("Folder"); drops.Name = "Drops"; drops.Parent = root
	local effects = Instance.new("Folder"); effects.Name = "Effects"; effects.Parent = root

	Lighting.ClockTime = 14.4
	Lighting.Brightness = 2.4
	Lighting.Ambient = rgb(147, 165, 194)
	Lighting.OutdoorAmbient = rgb(156, 177, 197)
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.65
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Name = "LuckyTideAtmosphere"; atmosphere.Density = 0.25; atmosphere.Offset = 0.2
	atmosphere.Color = rgb(205, 235, 255); atmosphere.Decay = rgb(151, 194, 226); atmosphere.Parent = Lighting

	local sea = V.part(decor, "Ocean", Vector3.new(1400, 2, 1400), CFrame.new(0, -8, 120), rgb(40, 168, 196), Enum.Material.Glass)
	sea.Transparency = 0.22; sea.CanCollide = false
	V.part(decor, "IslandRock", Vector3.new(232, 16, 212), CFrame.new(0, -9, -68), rgb(204, 180, 138), Enum.Material.Sandstone)
	V.part(decor, "Island", Vector3.new(226, 2, 206), CFrame.new(0, -1, -68), rgb(119, 196, 129), Enum.Material.Grass)
	V.part(decor, "Plaza", Vector3.new(53, 0.3, 185), CFrame.new(0, 0.15, -65), rgb(229, 224, 207))
	V.part(decor, "Beach", Vector3.new(142, 4, 325), CFrame.new(0, -2, 192), rgb(243, 222, 165), Enum.Material.Sand)
	V.part(decor, "SafeLine", Vector3.new(142, 0.12, 1), CFrame.new(0, 0.08, 29), rgb(83, 255, 192), Enum.Material.Neon)
	local sign = V.part(decor, "SafeSign", Vector3.new(31, 5, 0.6), CFrame.new(0, 5, 25), rgb(22, 67, 71))
	sign.CanCollide = false
	V.label(sign, "БЕЗОПАСНЫЙ БЕРЕГ\nДонеси яйцо на свою базу", rgb(172, 255, 218), 380, 66, Vector3.new(0, 1, 0))

	local title = V.part(decor, "Welcome", Vector3.new(38, 7, 1), CFrame.new(0, 10, -164), rgb(22, 48, 66))
	V.label(title, "LUCKY TIDE\nПни • спаси • вырасти", rgb(255, 226, 122), 450, 95, Vector3.new(0, 0, 0))
	for _, x in ipairs({-20, 20}) do V.part(decor, "SignPost", Vector3.new(1, 14, 1), CFrame.new(x, 6, -164), rgb(163, 121, 79), Enum.Material.Wood) end
	for _, x in ipairs({-104, 104}) do
		for z = -150, 10, 40 do tree(decor, x, z, 0.8 + (z % 3) * 0.15) end
	end

	local templates = ServerStorage:FindFirstChild("LuckyTideAssets")
	local baseTemplate = templates and templates:FindFirstChild("BaseTemplate")
	local plotList = {}
	for i = 1, 6 do
		local side = if i <= 3 then -1 else 1
		local row = (i - 1) % 3
		local x, z = side * 73, -127 + row * 59
		-- Local front is -Z; every plot faces the plaza.
		local cf = CFrame.new(x, 0, z) * CFrame.Angles(0, if side == -1 then -math.pi / 2 else math.pi / 2, 0)
		local plot = Instance.new("Model"); plot.Name = "Plot" .. i; plot:SetAttribute("PlotId", i); plot.Parent = plots
		local floor = V.part(plot, "Floor", Vector3.new(49, 0.8, 49), cf * CFrame.new(0, 0.4, 0), rgb(244, 238, 218))
		plot.PrimaryPart = floor
		V.part(plot, "Trim", Vector3.new(51, 0.3, 51), cf * CFrame.new(0, 0, 0), rgb(60, 163, 159))
		if baseTemplate then
			local copy = baseTemplate:Clone(); copy.Name = "OriginalBase"; copy.Parent = plot
			for _, obj in ipairs(copy:GetDescendants()) do
				if obj:IsA("LuaSourceContainer") or obj:IsA("ProximityPrompt") or obj:IsA("SpawnLocation") then obj:Destroy()
				elseif obj:IsA("BasePart") then obj.Anchored = true end
			end
			if copy:IsA("Model") and copy:FindFirstChildWhichIsA("BasePart", true) then
				V.fit(copy, cf * CFrame.new(0, 2.55, 0), Vector3.new(47, 5, 47), false)
			end
		else
			V.part(plot, "BackWall", Vector3.new(49, 9, 1), cf * CFrame.new(0, 5, 24), rgb(237, 230, 213))
			for _, sx in ipairs({-24, 24}) do
				V.part(plot, "SideWall", Vector3.new(1, 9, 31), cf * CFrame.new(sx, 5, 8), rgb(237, 230, 213))
				V.part(plot, "Pillar", Vector3.new(1.5, 11, 1.5), cf * CFrame.new(sx, 6, -19), rgb(57, 123, 128))
			end
			V.part(plot, "Canopy", Vector3.new(51, 1, 11), cf * CFrame.new(0, 11.5, 19), rgb(73, 163, 160))
		end
		local name = V.part(plot, "NameBoard", Vector3.new(25, 3, 0.5), cf * CFrame.new(0, 8, -23), rgb(25, 56, 70))
		name.CanCollide = false
		local titleLabel = V.label(name, "СВОБОДНАЯ БАЗА", rgb(255, 255, 255), 260, 45, Vector3.zero)
		local spawn = Instance.new("SpawnLocation"); spawn.Name = "Spawn"; spawn.Size = Vector3.new(7, 0.2, 7)
		spawn.CFrame = cf * CFrame.new(0, 1, -15); spawn.Transparency = 1; spawn.Anchored = true
		spawn.CanCollide = false; spawn.Neutral = true; spawn.Enabled = false; spawn.Parent = plot
		local deposit = V.part(plot, "Deposit", Vector3.new(14, 0.25, 7), cf * CFrame.new(0, 0.95, -16), rgb(78, 212, 169), Enum.Material.Neon)
		V.label(deposit, "ПОЛОЖИТЬ ЯЙЦО", rgb(195, 255, 222), 180, 35, Vector3.new(0, 1, 0))
		local collect = V.part(plot, "Collect", Vector3.new(7, 0.3, 7), cf * CFrame.new(-17, 1, -16), rgb(255, 207, 73))
		local bankLabel = V.label(collect, "$0\nСОБРАТЬ", rgb(255, 232, 143), 150, 55, Vector3.new(0, 2, 0))
		local shield = V.part(plot, "ShieldButton", Vector3.new(5, 1, 5), cf * CFrame.new(18, 1.25, -16), rgb(89, 180, 241))
		V.label(shield, "ЩИТ", rgb(174, 223, 255), 130, 35, Vector3.new(0, 2, 0))
		local barrier = V.part(plot, "ShieldVisual", Vector3.new(47, 9, 0.35), cf * CFrame.new(0, 5, -23), rgb(101, 207, 255), Enum.Material.ForceField)
		barrier.Transparency = 1; barrier.CanCollide = false
		local slots = {}
		for slot = 1, 10 do
			local sx = -18 + ((slot - 1) % 5) * 9
			local sz = if slot <= 5 then 1 else 15
			local pad = V.part(plot, "Slot" .. slot, Vector3.new(6.5, 0.6, 6.5), cf * CFrame.new(sx, 1.1, sz), rgb(201, 218, 215))
			pad:SetAttribute("SlotIndex", slot)
			slots[slot] = pad
		end
		local display = Instance.new("Folder"); display.Name = "Collection"; display.Parent = plot
		plotList[i] = {Model = plot, CF = cf, Spawn = spawn, Deposit = deposit, Collect = collect,
			BankLabel = bankLabel, Shield = shield, Barrier = barrier, Title = titleLabel, Slots = slots, Display = display}
	end

	local gym = V.part(root, "Training", Vector3.new(13, 0.3, 11), CFrame.new(0, 0.4, -129), rgb(96, 133, 231))
	V.label(gym, "ТРЕНИРОВКА\n+ СИЛА УДАРА", rgb(200, 216, 255), 240, 65, Vector3.new(0, 5, 0))
	V.part(decor, "WeightBar", Vector3.new(10, 0.6, 0.6), CFrame.new(0, 2, -129), rgb(74, 84, 104), Enum.Material.Metal)
	for _, x in ipairs({-4, 4}) do V.part(decor, "Weight", Vector3.new(1.5, 3, 3), CFrame.new(x, 2, -129), rgb(48, 61, 86)) end
	local shop = V.part(root, "UpgradeShop", Vector3.new(13, 3, 7), CFrame.new(0, 1.6, -103), rgb(252, 195, 77))
	V.label(shop, "УЛУЧШЕНИЯ", rgb(255, 233, 159), 230, 45, Vector3.new(0, 3, 0))

	local config = require(game:GetService("ReplicatedStorage").LuckyTide.Config)
	local stations = {}
	for tier = 1, 5 do
		local z = 47 + (tier - 1) * 57
		local color = V.color(config.Rarities[tier].Color)
		local stripe = V.part(decor, "Zone" .. tier, Vector3.new(140, 0.07, 2), CFrame.new(0, 0.04, z - 12), color)
		stripe.CanCollide = false
		local zoneSign = V.part(decor, "ZoneSign", Vector3.new(1, 5, 1), CFrame.new(-66, 2.5, z), rgb(170, 127, 83))
		V.label(zoneSign, config.Rarities[tier].Name .. "\nСИЛА " .. config.Rarities[tier].Required, color, 230, 70, Vector3.new(0, 4, 0))
		for _, x in ipairs({-35, 0, 35}) do
			local pad = V.part(blocks, "BlockPad", Vector3.new(7, 0.5, 7), CFrame.new(x, 0.25, z), color:Lerp(rgb(250, 239, 208), 0.6))
			pad:SetAttribute("Tier", tier)
			table.insert(stations, {Position = Vector3.new(x, 2.6, z), Tier = tier, Pad = pad, Variant = #stations + 1})
		end
	end
	for _, z in ipairs({112, 226}) do
		for _, x in ipairs({-59, 59}) do
			V.part(decor, "Refuge", Vector3.new(14, 12, 16), CFrame.new(x, 6, z), rgb(159, 190, 179), Enum.Material.Slate)
			for step = 1, 6 do
				V.part(decor, "RefugeStep", Vector3.new(10, step * 2, 3), CFrame.new(x, step, z - 27 + step * 3), rgb(182, 209, 190))
			end
			local flag = V.part(decor, "RefugeFlag", Vector3.new(0.5, 6, 0.5), CFrame.new(x, 15, z), rgb(250, 246, 218))
			V.label(flag, "УКРЫТИЕ", rgb(195, 255, 221), 160, 35, Vector3.new(0, 3, 0))
		end
	end

	workspace:SetAttribute("LuckyTideSafeZ", 29)
	return {Root = root, Plots = plotList, Blocks = blocks, Drops = drops, Effects = effects, Stations = stations, Gym = gym, Shop = shop,
		Templates = templates and templates:FindFirstChild("LuckyBlocks")}
end

function World.Load()
	local root = workspace:FindFirstChild("LuckyTideWorld")
	if not root then return World.Build() end
	local plots, stations = {}, {}
	for _, model in ipairs(root.Plots:GetChildren()) do
		local slots = {}
		for i = 1, 10 do slots[i] = model:FindFirstChild("Slot" .. i) end
		plots[model:GetAttribute("PlotId")] = {Model = model, CF = model.Floor.CFrame * CFrame.new(0, -0.4, 0),
			Spawn = model.Spawn, Deposit = model.Deposit, Collect = model.Collect, BankLabel = model.Collect.Label.Text,
			Shield = model.ShieldButton, Barrier = model.ShieldVisual, Title = model.NameBoard.Label.Text, Slots = slots, Display = model.Collection}
	end
	for _, pad in ipairs(root.Blocks:GetChildren()) do
		if pad.Name == "BlockPad" then
			table.insert(stations, {Position = pad.CFrame.Position + Vector3.new(0, 2.35, 0), Tier = pad:GetAttribute("Tier"), Pad = pad, Variant = #stations + 1})
		end
	end
	for _, display in ipairs(root.Blocks:GetChildren()) do if display:IsA("Model") then display:Destroy() end end
	local assets = ServerStorage:FindFirstChild("LuckyTideAssets")
	return {Root = root, Plots = plots, Stations = stations, Blocks = root.Blocks, Drops = root.Drops, Effects = root.Effects,
		Gym = root.Training, Shop = root.UpgradeShop, Templates = assets and assets:FindFirstChild("LuckyBlocks")}
end

return World
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="1836">
        <Properties>
          <string name="Name">Visuals</string>
          <string name="Source"><![CDATA[local Shared = game:GetService("ReplicatedStorage"):WaitForChild("LuckyTide")
local Config = require(Shared.Config)
local Rules = require(Shared.Rules)
local V = {}

function V.bounds(model)
	local low = Vector3.new(math.huge, math.huge, math.huge)
	local high = -low
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			for x = -1, 1, 2 do for y = -1, 1, 2 do for z = -1, 1, 2 do
				local point = p.CFrame * (p.Size * Vector3.new(x, y, z) / 2)
				low = low:Min(point); high = high:Max(point)
			end end end
		end
	end
	return (low + high) / 2, high - low
end

function V.fit(model, cf, target, uniform)
	local center, size = V.bounds(model)
	local scale = target / size
	if uniform then local n = math.min(scale.X, scale.Y, scale.Z); scale = Vector3.new(n, n, n) end
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			local rotation = p.CFrame - p.CFrame.Position
			p.Size *= scale
			p.CFrame = cf * CFrame.new((p.CFrame.Position - center) * scale) * rotation
		end
	end
	return size * scale
end

function V.color(rgb) return Color3.fromRGB(rgb[1], rgb[2], rgb[3]) end

function V.part(parent, name, size, cf, color, material)
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.CFrame = cf
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Parent = parent
	return p
end

function V.label(part, text, color, width, height, offset)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = UDim2.fromOffset(width or 220, height or 60)
	gui.StudsOffset = offset or Vector3.new(0, 4, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 120
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold)
	label.TextSize = 18
	label.TextColor3 = color or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.35
	label.TextStrokeColor3 = Color3.fromRGB(14, 27, 46)
	label.Text = text
	label.Parent = gui
	return label
end

function V.prompt(part, action, object, hold, callback)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = action
	prompt.ObjectText = object
	prompt.HoldDuration = hold or 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = part
	local began = setmetatable({}, {__mode = "k"})
	if prompt.HoldDuration > 0 then
		prompt.PromptButtonHoldBegan:Connect(function(player)
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if prompt.Enabled and root and (root.CFrame.Position - part.CFrame.Position).Magnitude <= 13 then began[player] = os.clock() end
		end)
	end
	prompt.Triggered:Connect(function(player)
		local char = player.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local held = prompt.HoldDuration == 0 or (began[player] and os.clock() - began[player] >= prompt.HoldDuration - 0.12)
		began[player] = nil
		if held and prompt.Enabled and root and hum and hum.Health > 0 and (root.CFrame.Position - part.CFrame.Position).Magnitude <= 13 then
			callback(player, prompt)
		end
	end)
	return prompt
end

function V.egg(parent, cf, tier, golden)
	local color = if golden then Color3.fromRGB(255, 216, 84) else V.color(Config.Rarities[tier].Color)
	local egg = V.part(parent, "Egg", Vector3.new(2.6, 3.3, 2.6), cf, color)
	egg.Shape = Enum.PartType.Ball
	egg.CanCollide = false
	local light = Instance.new("PointLight")
	light.Color = color; light.Range = 8; light.Brightness = 0.7; light.Parent = egg
	for i = 1, 6 do
		local a = math.pi * 2 * i / 6
		local spot = V.part(egg, "Spot", Vector3.new(0.5, 0.5, 0.15), cf * CFrame.new(math.sin(a) * 1.18, 0, math.cos(a) * 1.18) * CFrame.Angles(0, a, 0), Color3.new(1, 1, 1))
		spot.Shape = Enum.PartType.Ball; spot.CanCollide = false
		local weld = Instance.new("WeldConstraint"); weld.Part0 = egg; weld.Part1 = spot; weld.Parent = spot
		spot.Anchored = false; spot.Massless = true
	end
	return egg
end

function V.pet(parent, cf, item)
	local def = Rules.findPet(Config, item.PetId)
	local model = Instance.new("Model"); model.Name = def.Name; model.Parent = parent
	local color = if item.Mutation == "Golden" then Color3.fromRGB(255, 210, 73) else V.color(def.Color)
	local body = V.part(model, "Body", Vector3.new(2.7, 2.4, 2.5), cf, color)
	model.PrimaryPart = body
	local function part(name, size, offset, col)
		local p = V.part(model, name, size, cf * offset, col); p.CanCollide = false; return p
	end
	for _, x in ipairs({-0.65, 0.65}) do
		part("Eye", Vector3.new(0.36, 0.48, 0.16), CFrame.new(x, 0.2, -1.28), Color3.fromRGB(21, 32, 52))
		part("EyeShine", Vector3.new(0.12, 0.14, 0.05), CFrame.new(x - 0.06, 0.31, -1.38), Color3.new(1, 1, 1))
		part("Cheek", Vector3.new(0.45, 0.18, 0.1), CFrame.new(x * 1.3, -0.25, -1.28), Color3.fromRGB(255, 155, 174))
		part("Foot", Vector3.new(0.7, 0.35, 1), CFrame.new(x, -1.3, -0.35), color:Lerp(Color3.new(1, 1, 1), 0.3))
	end
	part("Nose", Vector3.new(0.25, 0.18, 0.2), CFrame.new(0, -0.08, -1.32), Color3.fromRGB(54, 53, 80))
	if def.Shape == "Bunny" then
		for _, x in ipairs({-0.7, 0.7}) do
			part("Ear", Vector3.new(0.65, 1.8, 0.65), CFrame.new(x, 1.8, 0) * CFrame.Angles(0, 0, -x * 0.2), color)
		end
	elseif def.Shape == "Bird" then
		part("Beak", Vector3.new(0.7, 0.45, 0.65), CFrame.new(0, -0.1, -1.45), Color3.fromRGB(255, 174, 59))
		for _, x in ipairs({-1.6, 1.6}) do part("Wing", Vector3.new(0.6, 1.25, 1.5), CFrame.new(x, 0, 0), color) end
	else
		for _, x in ipairs({-0.9, 0.9}) do
			part("Ear", Vector3.new(0.7, 1, 0.8), CFrame.new(x, 1.35, 0) * CFrame.Angles(0, 0, -x * 0.2), color)
		end
		if def.Shape == "Dragon" then
			for _, x in ipairs({-1.8, 1.8}) do
				part("Fin", Vector3.new(1.3, 0.25, 2), CFrame.new(x, 0.5, 0.3) * CFrame.Angles(0, 0, x * 0.3), color:Lerp(Color3.new(1, 1, 1), 0.3))
			end
		end
	end
	if item.Mutation == "Golden" then
		local sparkles = Instance.new("Sparkles"); sparkles.SparkleColor = color; sparkles.Parent = body
	end
	for _, p in ipairs(model:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
	return model, body
end

function V.block(parent, cf, tier, templates, variant)
	local candidates = {}
	if templates then
		for _, t in ipairs(templates:GetChildren()) do
			if t:GetAttribute("BlockTier") == tier then table.insert(candidates, t) end
		end
	end
	table.sort(candidates, function(a, b) return a.Name < b.Name end)
	local template = candidates[1 + ((variant or 1) - 1) % math.max(1, #candidates)]
	assert(template and template:GetAttribute("SourceFile"), "Missing new blocks template for tier " .. tostring(tier))
	if template and (template:IsA("Model") or template:IsA("BasePart")) then
		local model = Instance.new("Model"); model.Name = "LuckyBlock"; model.Parent = parent
		model:SetAttribute("SourceFile", template:GetAttribute("SourceFile"))
		local copy = template:Clone(); copy.Parent = model
		for _, obj in ipairs(copy:GetDescendants()) do
			if obj:IsA("LuaSourceContainer") then obj:Destroy() end
		end
		local root = if copy:IsA("BasePart") then copy else copy:FindFirstChildWhichIsA("BasePart", true)
		for _, p in ipairs(copy:GetDescendants()) do
			if p:IsA("BasePart") and p.Name:sub(1, 5) == "Body_" then root = p; break end
		end
		if root then
			model.PrimaryPart = root
			for _, p in ipairs(model:GetDescendants()) do if p:IsA("BasePart") then p.Anchored = true; p.CanCollide = false end end
			V.fit(model, cf, Vector3.new(4, 4, 4), true)
			return model, root
		end
		model:Destroy()
	end
	error("Invalid new blocks template: " .. template.Name)
end

return V
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="1837">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Shared = game:GetService("ReplicatedStorage"):WaitForChild("LuckyTide")
local Config = require(Shared.Config)
local Rules = require(Shared.Rules)

local Data = {Profiles = {}, Sessions = {}}
local studio = RunService:IsStudio()
local store = if not studio then DataStoreService:GetDataStore(Config.DataStore) else nil
local token = game.JobId .. HttpService:GenerateGUID(false)
local LOCK_TIME = 180

function Data.Load(player)
	local raw
	if store then
		local loaded = false
		for attempt = 1, 3 do
			local accepted = false
			local ok, result = pcall(function()
				return store:UpdateAsync("Player_" .. player.UserId, function(old)
					old = if type(old) == "table" then old else {}
					accepted = false
					if old.Session and old.Session ~= token and (old.LockExpires or 0) > os.time() then return nil end
					accepted = true
					return {Data = old.Data or {}, Session = token, LockExpires = os.time() + LOCK_TIME}
				end)
			end)
			if ok and accepted and result then
				raw = result.Data
				loaded = true
				break
			end
			if not ok then warn("[LuckyTide] Profile load failed: ", result) end
			task.wait(attempt * 2)
		end
		if not loaded then
			player:Kick("Не удалось безопасно загрузить прогресс. Подождите минуту и зайдите снова.")
			return nil
		end
	end
	local profile = Rules.cleanProfile(raw, Config, os.time())
	local elapsed = math.clamp(os.time() - profile.LastSeen, 0, Config.OfflineCap)
	local offline = 0
	for _, item in ipairs(profile.Inventory) do
		if item.Hatched then
			offline += Rules.income(Rules.findPet(Config, item.PetId), item.Mutation, profile.Rebirths) * elapsed * 0.25
		end
	end
	profile.Bank = math.min(Config.MaxCash, profile.Bank + math.floor(offline))
	profile.LastSeen = os.time()
	Data.Profiles[player] = profile
	Data.Sessions[player] = {Busy = false, LastSave = os.clock(), Failures = 0, Closing = false}
	player:SetAttribute("PracticeMode", studio)
	return profile, math.floor(offline)
end

function Data.Save(player, release)
	local session = Data.Sessions[player]
	if not session then return false end
	if release then session.Closing = true end
	while session.Busy do task.wait(0.1) end
	if Data.Sessions[player] ~= session then return false end
	if session.Closing and not release then return false end
	session.Busy = true
	local profile = Data.Profiles[player]
	local snapshot = Rules.cleanProfile(profile, Config, os.time())
	snapshot.LastSeen = os.time()
	local succeeded = not store
	if store then
		for attempt = 1, 3 do
			local ownsLock = false
			local ok, err = pcall(function()
				store:UpdateAsync("Player_" .. player.UserId, function(old)
					ownsLock = type(old) == "table" and old.Session == token
					if not ownsLock then return nil end
					return {Data = snapshot, Session = if release then nil else token,
						LockExpires = if release then 0 else os.time() + LOCK_TIME}
				end)
			end)
			if ok and ownsLock then succeeded = true; break end
			if ok and not ownsLock then
				player:Kick("Сессия прогресса изменилась. Перезайдите, чтобы защитить сохранение.")
				break
			end
			warn("[LuckyTide] Save retry: ", err)
			task.wait(attempt)
		end
	end
	if succeeded then session.LastSave = os.clock(); session.Failures = 0
	else session.Failures += 1 end
	session.Busy = false
	if release then
		Data.Profiles[player] = nil
		Data.Sessions[player] = nil
	elseif not succeeded and os.clock() - session.LastSave > 120 then
		player:Kick("Сохранение временно недоступно. Перезайдите через минуту.")
	end
	return succeeded
end

return Data
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="1838">
        <Properties>
          <string name="Name">Main</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local Shared = ReplicatedStorage:WaitForChild("LuckyTide")
local Config = require(Shared.Config)
local Rules = require(Shared.Rules)
local Data = require(script.Parent.DataService)
local V = require(script.Parent.Visuals)
local World = require(script.Parent.World)
local world = World.Load()
local remote = Shared:WaitForChild("Action")
local stateRemote = Shared:WaitForChild("State")
local fx = Shared:WaitForChild("Effects")
local random = Random.new()
local sessions, drops = {}, {}
local closing = false
local nextWave = workspace:GetServerTimeNow() + Config.WaveInterval
local waveStart, wavePart = nil, nil
local refreshPlot, cancelCarry, deposit, sendState

local function notify(player, text, kind)
	if player.Parent then stateRemote:FireClient(player, "Toast", {Text = text, Kind = kind or "Info"}) end
end

local function rootOf(player)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return nil end
	return char:FindFirstChild("HumanoidRootPart"), hum
end

local function cooldown(player, key, duration)
	local s = sessions[player]
	if not s then return false end
	local now = os.clock()
	if now < (s.Cooldowns[key] or 0) then return false end
	s.Cooldowns[key] = now + duration
	return true
end

local function incomeOf(data)
	local total = 0
	for _, item in ipairs(data.Inventory) do
		if item.Hatched then total += Rules.income(Rules.findPet(Config, item.PetId), item.Mutation, data.Rebirths) end
	end
	return total
end

local function updateSpeed(player)
	local s, data = sessions[player], Data.Profiles[player]
	local _, hum = rootOf(player)
	if hum and s and data then hum.WalkSpeed = Rules.speed(data.Speed, s.Carry ~= nil) end
end

sendState = function(player)
	local data, s = Data.Profiles[player], sessions[player]
	if not data or not s or not player.Parent then return end
	local inventory = {}
	for _, item in ipairs(data.Inventory) do
		table.insert(inventory, {Id = item.Id, PetId = item.PetId, Tier = item.Tier, Mutation = item.Mutation,
			ReadyAt = item.ReadyAt, Hatched = item.Hatched, Stolen = item.ReservedBy ~= nil})
	end
	stateRemote:FireClient(player, "Profile", {
		Cash = data.Cash, Bank = data.Bank, Strength = data.Strength, Weight = data.Weight, Speed = data.Speed,
		Slots = data.Slots, Rebirths = data.Rebirths, Income = incomeOf(data), Hatched = data.Hatched,
		Tutorial = data.Tutorial, Inventory = inventory, Discovered = data.Discovered,
		PlotId = s.Plot.Model:GetAttribute("PlotId"), Home = s.Plot.Spawn.CFrame.Position,
		Carrying = s.Carry and {Tier = s.Carry.Item.Tier, Golden = s.Carry.Item.Mutation == "Golden", Stolen = s.Carry.Origin ~= nil},
		ShieldRemaining = math.max(0, math.ceil(s.ShieldUntil - os.clock())),
		ShieldCooldown = math.max(0, math.ceil(s.ShieldReady - os.clock())),
		Practice = RunService:IsStudio(),
	})
	local ls = player:FindFirstChild("leaderstats")
	if ls then ls.Cash.Value = math.floor(data.Cash); ls.Power.Value = data.Strength; ls.Rebirths.Value = data.Rebirths end
end

local function destroyDrop(id)
	local drop = drops[id]
	if drop then drops[id] = nil; drop.Part:Destroy() end
end

cancelCarry = function(player, reason)
	local s = sessions[player]
	if not s or not s.Carry then return end
	local carry = s.Carry; s.Carry = nil
	if carry.Part then carry.Part:Destroy() end
	if carry.Origin and Data.Profiles[carry.Origin] then
		carry.Item.ReservedBy = nil
		refreshPlot(carry.Origin)
		sendState(carry.Origin)
	end
	updateSpeed(player); sendState(player)
	if reason then notify(player, reason, "Warn") end
end

local function beginCarry(player, item, origin)
	local s, data = sessions[player], Data.Profiles[player]
	local root = rootOf(player)
	if not s or not root or s.Carry then return false end
	if #data.Inventory >= data.Slots then notify(player, "База заполнена. Продайте питомца или купите место.", "Warn"); return false end
	local part = V.egg(world.Drops, root.CFrame * CFrame.new(0, 1, -2.6), item.Tier, item.Mutation == "Golden")
	part.Anchored = false; part.Massless = true; part.CanCollide = false; part.CanTouch = false
	local weld = Instance.new("WeldConstraint"); weld.Part0 = root; weld.Part1 = part; weld.Parent = part
	V.label(part, "ДОНЕСИ НА БАЗУ", V.color(Config.Rarities[item.Tier].Color), 180, 40, Vector3.new(0, 2.5, 0))
	s.Carry = {Item = item, Origin = origin, Part = part, Started = os.clock()}
	if origin then item.ReservedBy = player end
	data.Tutorial = math.max(data.Tutorial, 1)
	updateSpeed(player); sendState(player)
	notify(player, "Яйцо у тебя! Вернись на зелёную площадку своей базы.", "Success")
	return true
end

deposit = function(player)
	local s, data = sessions[player], Data.Profiles[player]
	if not s or not s.Carry or #data.Inventory >= data.Slots then return end
	local root = rootOf(player)
	if not root or (root.CFrame.Position - s.Plot.Deposit.CFrame.Position).Magnitude > 12 then return end
	local carry = s.Carry
	if carry.Origin then
		local ownerData = Data.Profiles[carry.Origin]
		local index = ownerData and table.find(ownerData.Inventory, carry.Item)
		if not index or carry.Item.ReservedBy ~= player then cancelCarry(player, "Это яйцо уже вернулось владельцу."); return end
		table.remove(ownerData.Inventory, index)
		refreshPlot(carry.Origin); sendState(carry.Origin)
		notify(carry.Origin, "Яйцо похищено! Включайте щит у входа.", "Warn")
	end
	carry.Item.ReservedBy = nil
	carry.Item.ReadyAt = os.time() + Config.Rarities[carry.Item.Tier].Hatch
	carry.Item.Hatched = false
	table.insert(data.Inventory, carry.Item)
	s.Carry = nil; carry.Part:Destroy()
	data.Tutorial = math.max(data.Tutorial, 2)
	updateSpeed(player); refreshPlot(player); sendState(player)
	fx:FireAllClients("Burst", s.Plot.Deposit.CFrame.Position + Vector3.new(0, 2, 0), carry.Item.Tier)
	notify(player, "Яйцо в гнезде. Скоро вылупится питомец!", "Success")
end

refreshPlot = function(player)
	local s, data = sessions[player], Data.Profiles[player]
	if not s or not data then return end
	s.Plot.Display:ClearAllChildren()
	for i, pad in ipairs(s.Plot.Slots) do
		pad.Color = if i <= data.Slots then Color3.fromRGB(201, 218, 215) else Color3.fromRGB(90, 105, 111)
		local old = pad:FindFirstChild("Label"); if old then old:Destroy() end
		if i > data.Slots then V.label(pad, "ЗАКРЫТО", Color3.fromRGB(165, 177, 190), 100, 30, Vector3.new(0, 1.5, 0)) end
		local item = data.Inventory[i]
		if item and not item.ReservedBy then
			local pet = Rules.findPet(Config, item.PetId)
			if item.Hatched then
				local model, body = V.pet(s.Plot.Display, pad.CFrame * CFrame.new(0, 1.85, 0), item)
				model:SetAttribute("PetId", pet.Id)
				V.label(body, (if item.Mutation == "Golden" then "★ " else "") .. pet.Name .. "\n+$" .. Rules.format(Rules.income(pet, item.Mutation, data.Rebirths)) .. "/сек", V.color(Config.Rarities[pet.Tier].Color), 190, 55)
			else
				local egg = V.egg(s.Plot.Display, pad.CFrame * CFrame.new(0, 2, 0), item.Tier, item.Mutation == "Golden")
				egg:SetAttribute("ReadyAt", item.ReadyAt)
				V.label(egg, Config.Rarities[item.Tier].Name .. "\nВылупление: " .. math.max(0, item.ReadyAt - os.time()) .. "с", V.color(Config.Rarities[item.Tier].Color), 200, 60)
				V.prompt(egg, "Украсть яйцо", "Чужое гнездо", 2.5, function(thief)
					if thief == player or item.Hatched or item.ReservedBy or not sessions[thief] then return end
					if not table.find(data.Inventory, item) then return end
					if os.clock() < s.ShieldUntil then notify(thief, "База защищена щитом.", "Warn"); return end
					if beginCarry(thief, item, player) then
						notify(player, thief.DisplayName .. " крадёт яйцо! Догоните и нажмите Q.", "Warn")
						refreshPlot(player); sendState(player)
					end
				end)
			end
		end
	end
end

local function newItem(tier)
	local options = {}
	for _, pet in ipairs(Config.Pets) do if pet.Tier == tier then table.insert(options, pet) end end
	local pet = options[random:NextInteger(1, #options)]
	return {Id = HttpService:GenerateGUID(false), PetId = pet.Id, Tier = tier,
		Mutation = if random:NextNumber() < 0.06 then "Golden" else "Normal", ReadyAt = 0, Hatched = false}
end

local function spawnDrop(item, position, owner)
	local part = V.egg(world.Drops, CFrame.new(position), item.Tier, item.Mutation == "Golden")
	local id = item.Id
	local drop = {Part = part, Item = item, Owner = owner, ClaimAt = os.clock() + 5, Expires = os.clock() + Config.EggLifetime}
	drops[id] = drop
	V.label(part, (if item.Mutation == "Golden" then "★ ЗОЛОТОЕ\n" else "") .. Config.Rarities[item.Tier].Name .. " ЯЙЦО", V.color(Config.Rarities[item.Tier].Color), 220, 65)
	V.prompt(part, "Поднять", "Отнеси на базу", 0.15, function(player)
		if drops[id] ~= drop then return end
		if player ~= owner and os.clock() < drop.ClaimAt then notify(player, "Это яйцо пока закреплено за другим игроком."); return end
		if beginCarry(player, item) then destroyDrop(id) end
	end)
end

local function fillStation(station)
	local model, part = V.block(world.Blocks, CFrame.new(station.Position), station.Tier, world.Templates, station.Variant)
	station.Model = model; station.Busy = false
	local rarity = Config.Rarities[station.Tier]
	V.label(part, rarity.Name .. "\nСила " .. rarity.Required, V.color(rarity.Color), 190, 55)
	V.prompt(part, "Пнуть!", "Лаки-блок", 0.2, function(player)
		local s, data = sessions[player], Data.Profiles[player]
		if not s or station.Busy or s.Carry then return end
		if data.Strength < rarity.Required then notify(player, "Нужна сила " .. rarity.Required .. ". Тренируйся в центре!", "Warn"); return end
		if #data.Inventory >= data.Slots then notify(player, "Освободите место на базе.", "Warn"); return end
		local ownedDrops = 0
		for _, drop in pairs(drops) do if drop.Owner == player then ownedDrops += 1 end end
		if ownedDrops >= 3 then notify(player, "Сначала подбери уже выбитые яйца.", "Warn"); return end
		if not cooldown(player, "Kick", Config.KickCooldown) then return end
		station.Busy = true
		for _, obj in ipairs(model:GetDescendants()) do if obj:IsA("ProximityPrompt") or obj:IsA("BillboardGui") then obj:Destroy() end end
		local item = newItem(Rules.rollTier(station.Tier, random:NextNumber()))
		local startCF = model:GetPivot()
		local distance = math.min(30, 12 + data.Strength * 0.06)
		local offset = Vector3.new(0, 0, distance)
		fx:FireAllClients("Kick", station.Position, station.Tier, player)
		task.spawn(function()
			local start = os.clock()
			while model.Parent and os.clock() - start < 0.85 do
				local t = math.clamp((os.clock() - start) / 0.85, 0, 1)
				model:PivotTo(startCF + offset * t + Vector3.new(0, math.sin(t * math.pi) * 10, 0))
				RunService.Heartbeat:Wait()
			end
			model:Destroy()
			local landing = Vector3.new(station.Position.X, 2, station.Position.Z + distance)
			spawnDrop(item, landing, player)
			fx:FireAllClients("Burst", landing, item.Tier)
			notify(player, "Выпало " .. Config.Rarities[item.Tier].Name:lower() .. " яйцо!", "Success")
			task.wait(6)
			if not closing then fillStation(station) end
		end)
	end)
end

local function collect(player)
	local s, data = sessions[player], Data.Profiles[player]
	if not s or not cooldown(player, "Collect", 0.7) then return end
	local root = rootOf(player)
	if not root or (root.CFrame.Position - s.Plot.Collect.CFrame.Position).Magnitude > 13 then return end
	local amount = math.floor(data.Bank)
	if amount <= 0 then return end
	data.Cash = math.min(Config.MaxCash, data.Cash + amount); data.Bank = 0
	data.Tutorial = math.max(data.Tutorial, 4)
	notify(player, "+$" .. Rules.format(amount), "Success"); sendState(player)
end

local function shield(player)
	local s = sessions[player]
	if not s or not cooldown(player, "Shield", 1) then return end
	local root = rootOf(player)
	if not root or (root.CFrame.Position - s.Plot.Shield.CFrame.Position).Magnitude > 13 then return end
	if os.clock() < s.ShieldReady then notify(player, "Щит перезаряжается: " .. math.ceil(s.ShieldReady - os.clock()) .. "с"); return end
	s.ShieldUntil = os.clock() + Config.ShieldDuration; s.ShieldReady = os.clock() + Config.ShieldCooldown
	notify(player, "Гнёзда защищены на 45 секунд.", "Success"); sendState(player)
end

local function onPlayer(player)
	local data, offline = Data.Load(player)
	if not data then return end
	if not player.Parent or closing then Data.Save(player, true); return end
	local plot
	for _, candidate in ipairs(world.Plots) do if not candidate.Owner then plot = candidate; break end end
	if not plot then Data.Save(player, true); player:Kick("Все 6 баз заняты. Выберите другой сервер."); return end
	plot.Owner = player; plot.Model:SetAttribute("OwnerId", player.UserId); plot.Title.Text = player.DisplayName .. " · БАЗА"
	sessions[player] = {Plot = plot, Cooldowns = {}, ShieldUntil = os.clock() + 45, ShieldReady = 0, LastTrain = 0, RateAt = 0, RateCount = 0}
	local ls = Instance.new("Folder"); ls.Name = "leaderstats"; ls.Parent = player
	for _, name in ipairs({"Cash", "Power", "Rebirths"}) do local v = Instance.new("NumberValue"); v.Name = name; v.Parent = ls end
	player.RespawnLocation = plot.Spawn
	local function characterAdded(char)
		local root = char:WaitForChild("HumanoidRootPart", 10)
		local hum = char:WaitForChild("Humanoid", 10)
		if not root or not hum or not sessions[player] then return end
		char:PivotTo(plot.Spawn.CFrame + Vector3.new(0, 4, 0))
		updateSpeed(player)
		hum.Died:Connect(function() cancelCarry(player, "Яйцо потеряно. Попробуй ещё раз!") end)
		sendState(player)
	end
	player.CharacterAdded:Connect(characterAdded)
	if player.Character then task.spawn(characterAdded, player.Character) end
	refreshPlot(player); sendState(player)
	if offline > 0 then task.delay(3, function() notify(player, "Питомцы заработали без тебя: $" .. Rules.format(offline) .. ". Забери на базе!", "Success") end) end
end

for _, plot in ipairs(world.Plots) do
	V.prompt(plot.Deposit, "Положить яйцо", "Твоя база", 0, function(p) if plot.Owner == p then deposit(p) end end)
	V.prompt(plot.Collect, "Собрать доход", "Копилка", 0, function(p) if plot.Owner == p then collect(p) end end)
	V.prompt(plot.Shield, "Включить щит", "Защита яиц", 0.2, function(p) if plot.Owner == p then shield(p) end end)
end

V.prompt(world.Gym, "Тренироваться", "Встань на синюю площадку", 0, function(player)
	notify(player, "Стой на синей площадке: сила растёт каждую секунду.")
end)
V.prompt(world.Shop, "Открыть", "Улучшения", 0, function(player) stateRemote:FireClient(player, "OpenShop", {}) end)
for _, station in ipairs(world.Stations) do fillStation(station) end

remote.OnServerEvent:Connect(function(player, action, value)
	local s, data = sessions[player], Data.Profiles[player]
	if not s or not data or type(action) ~= "string" or not rootOf(player) then return end
	local now = os.clock()
	if now - s.RateAt >= 1 then s.RateAt = now; s.RateCount = 0 end
	s.RateCount += 1; if s.RateCount > 12 then return end
	if action == "Sync" then if cooldown(player, "Sync", 0.5) then sendState(player) end
	elseif action == "Home" or action == "Gym" then
		if s.Carry then notify(player, "С яйцом нужно дойти пешком!", "Warn"); return end
		if not cooldown(player, "Travel", 2) then return end
		local target = if action == "Home" then s.Plot.Spawn.CFrame else world.Gym.CFrame
		player.Character:PivotTo(target + Vector3.new(0, 4, 0))
	elseif action == "Drop" then cancelCarry(player, "Яйцо отпущено.")
	elseif action == "Upgrade" then
		if type(value) ~= "string" or not cooldown(player, "Upgrade", 0.25) then return end
		local level = if value == "Slots" then data.Slots - Config.BaseSlots else data[value]
		if value ~= "Slots" and value ~= "Weight" and value ~= "Speed" then return end
		local max = if value == "Slots" then Config.MaxSlots - Config.BaseSlots else 12
		if level >= max then notify(player, "Максимальный уровень."); return end
		local cost = Rules.upgradeCost(value, level)
		if data.Cash < cost then notify(player, "Нужно $" .. Rules.format(cost), "Warn"); return end
		data.Cash -= cost; data[value] += 1
		updateSpeed(player); refreshPlot(player); sendState(player); notify(player, "Улучшение куплено!", "Success")
	elseif action == "Sell" then
		if type(value) ~= "string" or not cooldown(player, "Sell", 0.3) then return end
		for i, item in ipairs(data.Inventory) do
			if item.Id == value and item.Hatched then
				local amount = Rules.income(Rules.findPet(Config, item.PetId), item.Mutation, data.Rebirths) * 30
				table.remove(data.Inventory, i); data.Cash = math.min(Config.MaxCash, data.Cash + amount)
				refreshPlot(player); sendState(player); notify(player, "Питомец продан: +$" .. Rules.format(amount), "Success"); break
			end
		end
	elseif action == "Rebirth" then
		if not cooldown(player, "Rebirth", 2) or data.Rebirths >= 15 then return end
		if s.Carry then notify(player, "Сначала положите яйцо.", "Warn"); return end
		local cost = Rules.rebirthCost(data.Rebirths)
		if data.Cash < cost then notify(player, "Для перерождения нужно $" .. Rules.format(cost), "Warn"); return end
		data.Cash = Config.StartingCash; data.Bank = 0; data.Strength = 0; data.Weight = 0; data.Speed = 0; data.Rebirths += 1
		refreshPlot(player); updateSpeed(player); sendState(player)
		notify(player, "Перерождение! Доход и тренировка усилены. Питомцы сохранены.", "Success")
	elseif action == "Shove" then
		if not cooldown(player, "Shove", 3) then return end
		local root = rootOf(player)
		for target, ts in pairs(sessions) do
			if target ~= player and ts.Carry and ts.Carry.Origin == player then
				local other = rootOf(target)
				if other and (other.CFrame.Position - root.CFrame.Position).Magnitude < 11 then
					cancelCarry(target, "Владелец отбил своё яйцо!")
					notify(player, "Яйцо вернулось в гнездо.", "Success")
					fx:FireAllClients("Burst", other.CFrame.Position, 2); break
				end
			end
		end
	end
end)

local function leave(player)
	local s = sessions[player]
	if s then
		cancelCarry(player)
		for other, otherSession in pairs(sessions) do
			if otherSession.Carry and otherSession.Carry.Origin == player then cancelCarry(other, "Владелец вышел; яйцо вернулось на его базу.") end
		end
		s.Plot.Owner = nil; s.Plot.Model:SetAttribute("OwnerId", nil)
		s.Plot.Title.Text = "СВОБОДНАЯ БАЗА"; s.Plot.Barrier.Transparency = 1
		s.Plot.BankLabel.Text = "$0\nСОБРАТЬ"; s.Plot.Display:ClearAllChildren()
		sessions[player] = nil
	end
	Data.Save(player, true)
end

Players.PlayerAdded:Connect(function(p) task.spawn(onPlayer, p) end)
Players.PlayerRemoving:Connect(leave)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(onPlayer, p) end

task.spawn(function()
	while not closing do
		task.wait(Config.AutosaveInterval)
		for p in pairs(Data.Profiles) do task.spawn(Data.Save, p, false) end
	end
end)

local incomeClock, updateClock, elapsedClock = 0, 0, 0
RunService.Heartbeat:Connect(function(dt)
	local now = os.clock()
	local serverNow = workspace:GetServerTimeNow()
	if not waveStart and serverNow >= nextWave then
		waveStart = serverNow
		wavePart = V.part(world.Effects, "Tsunami", Vector3.new(144, 11, 12), CFrame.new(0, 4, 355), Color3.fromRGB(55, 176, 238), Enum.Material.Glass)
		wavePart.Transparency = 0.25; wavePart.CanCollide = false
		local foam = V.part(wavePart, "Foam", Vector3.new(144, 1.5, 13), wavePart.CFrame * CFrame.new(0, 5, 0), Color3.fromRGB(225, 251, 255), Enum.Material.Neon)
		foam.CanCollide = false
		fx:FireAllClients("Wave")
	end
	if waveStart then
		local progress = (serverNow - waveStart) / Config.WaveDuration
		local z = 355 - progress * 326
		wavePart.CFrame = CFrame.new(0, 4, z)
		wavePart.Foam.CFrame = wavePart.CFrame * CFrame.new(0, 5, 0)
		for player, s in pairs(sessions) do
			local root, hum = rootOf(player)
			if root and root.CFrame.Position.Z > 29 and math.abs(root.CFrame.Position.X) < 73 and root.CFrame.Position.Y < 12 and math.abs(root.CFrame.Position.Z - z) < 9 then
				cancelCarry(player, "Волна смыла яйцо! В следующий раз ищи укрытие.")
				player.Character:PivotTo(s.Plot.Spawn.CFrame + Vector3.new(0, 4, 0))
				hum.Health = math.max(1, hum.Health - 25)
			end
		end
		if progress >= 1 then
			wavePart:Destroy(); wavePart = nil; waveStart = nil
			nextWave = serverNow + Config.WaveInterval
		end
	end
	workspace:SetAttribute("NextWave", nextWave)
	workspace:SetAttribute("WaveActive", waveStart ~= nil)
	incomeClock += dt; updateClock += dt; elapsedClock += dt
	if elapsedClock < 0.25 then return end
	elapsedClock = 0
	local paySeconds = math.floor(incomeClock)
	if paySeconds > 0 then incomeClock -= paySeconds end
	for id, drop in pairs(drops) do if drop.Expires <= now then destroyDrop(id) end end
	for player, s in pairs(sessions) do
		local data = Data.Profiles[player]
		local root = rootOf(player)
		local changed = false
		if data then
			if paySeconds > 0 then data.Bank = math.min(Config.MaxCash, data.Bank + incomeOf(data) * paySeconds) end
			for _, item in ipairs(data.Inventory) do
				if not item.Hatched and not item.ReservedBy and item.ReadyAt <= os.time() then
					item.Hatched = true; data.Hatched += 1; data.Discovered[item.PetId] = true; data.Tutorial = math.max(data.Tutorial, 3)
					changed = true
					notify(player, "Вылупился " .. Rules.findPet(Config, item.PetId).Name .. "!", "Success")
					fx:FireAllClients("Burst", s.Plot.Spawn.CFrame.Position + Vector3.new(0, 5, 0), item.Tier)
				end
			end
			s.Plot.BankLabel.Text = "$" .. Rules.format(data.Bank) .. "\nСОБРАТЬ"
			s.Plot.Barrier.Transparency = if now < s.ShieldUntil then 0.65 else 1
			for _, egg in ipairs(s.Plot.Display:GetChildren()) do
				if egg:IsA("BasePart") and egg:GetAttribute("ReadyAt") then
					local t = math.max(0, egg:GetAttribute("ReadyAt") - os.time())
					egg.Label.Text.Text = "ЯЙЦО\nВылупление: " .. t .. "с"
				end
			end
			if root then
				if root.CFrame.Position.Y < -18 then cancelCarry(player, "Ты упал в океан."); player.Character:PivotTo(s.Plot.Spawn.CFrame + Vector3.new(0, 4, 0)) end
				if s.Carry then
					if now - s.Carry.Started > Config.CarryTimeout then cancelCarry(player, "Время доставки истекло.")
					elseif (root.CFrame.Position - s.Plot.Deposit.CFrame.Position).Magnitude < 9 then deposit(player) end
				elseif (root.CFrame.Position - world.Gym.CFrame.Position).Magnitude < 8 and now - s.LastTrain >= 1.1 then
					s.LastTrain = now
					local gain = math.max(1, math.floor((2 + data.Weight * 2) * Rules.multiplier(data.Rebirths)))
					data.Strength = math.min(Config.MaxStrength, data.Strength + gain)
					stateRemote:FireClient(player, "Training", {Gain = gain})
				end
				if (root.CFrame.Position - s.Plot.Collect.CFrame.Position).Magnitude < 6 then collect(player) end
			end
			if changed then refreshPlot(player) end
			if updateClock >= 1 then sendState(player) end
		end
	end
	if updateClock >= 1 then updateClock = 0 end
end)

game:BindToClose(function()
	closing = true
	local pending = 0
	for player in pairs(Data.Profiles) do
		pending += 1
		task.spawn(function() leave(player); pending -= 1 end)
	end
	local start = os.clock()
	while pending > 0 and os.clock() - start < 25 do task.wait(0.1) end
end)

print("[LuckyTide] Ready: 6 plots, 15 lucky block stations, waves, hatching, upgrades and protected saves.")
